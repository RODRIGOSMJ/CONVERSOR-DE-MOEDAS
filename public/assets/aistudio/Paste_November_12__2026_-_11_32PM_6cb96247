        function downloadHtmlAppFile() {
            const fullHtml = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
            const blob = new Blob([fullHtml], { type: 'text/html;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'index.html';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast('Aplicativo baixado com sucesso!');
        }

        function saveToStorage() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify({
                    selectedCodes: appState.selectedCodes,
                    activeCode: appState.activeCode,
                    inputString: appState.inputString,
                    baseRatesUsd,
                    customRatesUsd: appState.customRatesUsd
                }));
            } catch (e) {}
        }

        function loadFromStorage() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (!raw) return;
                const saved = JSON.parse(raw);
                if (Array.isArray(saved.selectedCodes) && saved.selectedCodes.length >= 2) {
                    appState.selectedCodes = [...saved.selectedCodes];
                    ['DOGE', 'XRP', 'LTC'].forEach(c => {
                        if (!appState.selectedCodes.includes(c)) appState.selectedCodes.push(c);
                    });
                }
                if (saved.activeCode && appState.selectedCodes.includes(saved.activeCode)) {
                    appState.activeCode = saved.activeCode;
                }
                if (typeof saved.inputString === 'string' && saved.inputString.length > 0) {
                    appState.inputString = saved.inputString;
                }
                if (saved.baseRatesUsd) {
                    Object.assign(baseRatesUsd, saved.baseRatesUsd);
                }
                if (saved.customRatesUsd) {
                    appState.customRatesUsd = saved.customRatesUsd;
                }
            } catch (e) {}
        }

