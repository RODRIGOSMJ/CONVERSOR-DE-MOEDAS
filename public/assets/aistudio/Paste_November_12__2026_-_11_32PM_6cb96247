<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#1e1e1e">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="CONVERSOR PLUS">
    <title>CONVERSOR PLUS</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <!-- Chart.js para histórico de cotações -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Fonte Roboto (limpa, robusta e altamente legível no mobile) -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Roboto', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        html, body {
            overscroll-behavior: none;
            overscroll-behavior-y: none;
            -webkit-tap-highlight-color: transparent;
            font-family: 'Roboto', sans-serif;
            font-variant-numeric: tabular-nums;
        }
        #currency-list-container {
            overscroll-behavior-y: contain;
        }
        .keypad-btn {
            transition: background-color 0.08s ease, transform 0.07s ease;
            user-select: none;
        }
        .keypad-btn:active {
            transform: scale(0.95);
        }
        .currency-scroll::-webkit-scrollbar {
            width: 4px;
        }
        .currency-scroll::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.3);
            border-radius: 9999px;
        }
        #keypad-drawer {
            transition: max-height 0.28s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease;
        }
        .currency-row-item {
            transition: background-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
            touch-action: pan-y;
        }
        .drag-handle {
            touch-action: none;
            cursor: grab;
        }
        .drag-handle:active {
            cursor: grabbing;
        }
        .currency-row-dragging {
            opacity: 0.96;
            transform: scale(1.02);
            box-shadow: 0 12px 28px -6px rgba(79, 134, 198, 0.45);
            z-index: 30;
            position: relative;
        }
        .currency-row-over {
            border-top: 2.5px solid #4f86c6 !important;
        }
    </style>
</head>
<body class="bg-slate-200 dark:bg-[#0d0d0d] text-slate-900 dark:text-[#f2f2f2] font-sans antialiased h-screen overflow-hidden flex items-center justify-center">

    <!-- Container de Toast -->
    <div id="toast-container" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 max-w-xs w-full pointer-events-none px-4"></div>

    <!-- Moldura Principal Mobile Clean -->
    <div class="w-full h-full sm:h-[94vh] sm:max-w-[440px] bg-white dark:bg-[#141414] sm:rounded-[28px] sm:border sm:border-slate-300 dark:sm:border-[#2a2a2a] shadow-2xl flex flex-col overflow-hidden relative">

        <!-- TOP BAR CLEAN & ROBUSTA COM MENU NOS TRÊS PONTINHOS -->
        <header class="bg-slate-100 dark:bg-[#1e1e1e] text-slate-900 dark:text-white px-4 py-3.5 flex items-center justify-between shrink-0 z-30 border-b border-slate-200 dark:border-[#282828] relative">
            <button onclick="toggleTheme()" class="p-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 transition text-slate-700 dark:text-slate-200" title="Alternar tema claro/escuro">
                <i data-lucide="sun" id="theme-icon" class="w-5 h-5"></i>
            </button>

            <div class="flex items-center gap-2">
                <span class="font-bold text-base sm:text-lg tracking-wide">CONVERSOR <span class="font-normal">PLUS</span></span>
                <span class="px-2 py-0.5 rounded-full bg-[#4f86c6] text-[#0f172a] font-extrabold text-[11px] tracking-wider">PRO</span>
            </div>

            <div class="flex items-center gap-0.5 relative">
                <button onclick="toggleKeypad()" class="p-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition text-slate-700 dark:text-slate-200" title="Recolher / Expandir teclado">
                    <i data-lucide="chevron-down" id="keypad-chevron" class="w-5 h-5 transition-transform duration-200"></i>
                </button>
                <button id="top-menu-btn" onclick="toggleTopMenu(event)" class="p-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition text-slate-700 dark:text-slate-200" title="Mais opções">
                    <i data-lucide="more-vertical" class="w-5 h-5"></i>
                </button>

                <!-- Menu Suspenso dos Três Pontinhos -->
                <div id="top-dropdown-menu" class="hidden absolute right-0 top-11 w-56 rounded-2xl bg-white dark:bg-[#232323] border border-slate-200 dark:border-[#363636] shadow-2xl py-1.5 z-50 overflow-hidden">
                    <button onclick="closeTopMenu(); openAddCurrencyModal()" class="w-full px-4 py-3 text-left text-sm font-medium text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-[#2f2f2f] flex items-center gap-3 transition">
                        <i data-lucide="list-plus" class="w-4 h-4 text-[#4f86c6]"></i>
                        <span>Gerenciar moedas</span>
                    </button>
                    <div class="h-px bg-slate-200 dark:bg-[#333333] mx-3"></div>
                    <button onclick="closeTopMenu(); openInstallHelpModal()" class="w-full px-4 py-3 text-left text-sm font-medium text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-[#2f2f2f] flex items-center gap-3 transition">
                        <i data-lucide="download" class="w-4 h-4 text-emerald-500"></i>
                        <span>Baixar aplicativo</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- BARRA DE STATUS / DATA ATUALIZAÇÃO -->
        <div onclick="fetchLiveRates(true)" class="bg-slate-50 dark:bg-[#141414] text-slate-500 dark:text-[#9e9e9e] text-xs sm:text-[13px] font-medium py-1.5 px-4 text-center border-b border-slate-200/70 dark:border-[#222222] cursor-pointer hover:text-sky-500 transition shrink-0">
            <span id="sync-status-text">Atualizado agora • Puxe para baixo para atualizar</span>
        </div>

        <!-- INDICADOR VISUAL DE PULL-TO-REFRESH -->
        <div id="pull-refresh-indicator" class="overflow-hidden transition-all duration-150 bg-slate-100/90 dark:bg-[#19202a] flex items-center justify-center gap-2 text-xs font-bold text-[#4f86c6] shrink-0" style="height: 0px; opacity: 0;">
            <i data-lucide="refresh-cw" id="pull-refresh-icon" class="w-4 h-4 transition-transform duration-150"></i>
            <span id="pull-refresh-label">Puxe para atualizar cotações</span>
        </div>

        <!-- BARRA DE EXPRESSÃO MATEMÁTICA ATIVA -->
        <div id="expression-banner" class="hidden bg-sky-50 dark:bg-[#1d2733] border-b border-sky-200 dark:border-[#2b3b4e] px-4 py-2 flex items-center justify-between text-sm shrink-0">
            <span class="text-slate-600 dark:text-slate-300 font-medium">
                Conta (<strong id="expr-currency-code" class="text-slate-900 dark:text-white">USD</strong>):
            </span>
            <span id="expression-text" class="font-bold text-base text-sky-600 dark:text-[#6aa3e8]">100 + 50</span>
        </div>

        <!-- LISTA DE MOEDAS SIMULTÂNEAS -->
        <div id="currency-list-container" class="flex-1 overflow-y-auto currency-scroll divide-y divide-slate-200 dark:divide-[#232323] bg-white dark:bg-[#141414]">
            <!-- Linhas geradas dinamicamente -->
        </div>

        <!-- TECLADO NUMÉRICO ROBUSTO -->
        <div id="keypad-drawer" class="bg-slate-100 dark:bg-[#1d1d1d] rounded-t-2xl border-t border-slate-200 dark:border-[#2a2a2a] shrink-0 overflow-hidden max-h-[340px] opacity-100">
            <div onclick="toggleKeypad()" class="w-full py-1.5 flex justify-center cursor-pointer">
                <div class="w-8 h-1 rounded-full bg-slate-300 dark:bg-[#4a4a4a]"></div>
            </div>

            <div class="px-2.5 pb-2.5 grid grid-cols-4 gap-2">
                <!-- Linha 1: C, 7, 8, 9 -->
                <button onclick="pressClear()" class="keypad-btn h-13 py-2.5 rounded-xl bg-white dark:bg-[#2a2a2a] hover:bg-slate-50 dark:hover:bg-[#333333] text-[#d9534f] font-medium text-2xl shadow-xs">
                    C
                </button>
                <button onclick="pressDigit('7')" class="keypad-btn h-13 py-2.5 rounded-xl bg-white dark:bg-[#2a2a2a] hover:bg-slate-50 dark:hover:bg-[#333333] text-slate-900 dark:text-[#f2f2f2] font-normal text-2xl shadow-xs">
                    7
                </button>
                <button onclick="pressDigit('8')" class="keypad-btn h-13 py-2.5 rounded-xl bg-white dark:bg-[#2a2a2a] hover:bg-slate-50 dark:hover:bg-[#333333] text-slate-900 dark:text-[#f2f2f2] font-normal text-2xl shadow-xs">
                    8
                </button>
                <button onclick="pressDigit('9')" class="keypad-btn h-13 py-2.5 rounded-xl bg-white dark:bg-[#2a2a2a] hover:bg-slate-50 dark:hover:bg-[#333333] text-slate-900 dark:text-[#f2f2f2] font-normal text-2xl shadow-xs">
                    9
                </button>

                <!-- Linha 2: Inverter (⇄), 4, 5, 6 -->
                <button onclick="swapTopTwoCurrencies()" class="keypad-btn h-13 py-2.5 rounded-xl bg-white dark:bg-[#2a2a2a] hover:bg-slate-50 dark:hover:bg-[#333333] text-[#4f86c6] font-bold text-xl shadow-xs flex items-center justify-center" title="Inverter moedas principais">
                    <i data-lucide="refresh-cw" class="w-5 h-5"></i>
                </button>
                <button onclick="pressDigit('4')" class="keypad-btn h-13 py-2.5 rounded-xl bg-white dark:bg-[#2a2a2a] hover:bg-slate-50 dark:hover:bg-[#333333] text-slate-900 dark:text-[#f2f2f2] font-normal text-2xl shadow-xs">
                    4
                </button>
                <button onclick="pressDigit('5')" class="keypad-btn h-13 py-2.5 rounded-xl bg-white dark:bg-[#2a2a2a] hover:bg-slate-50 dark:hover:bg-[#333333] text-slate-900 dark:text-[#f2f2f2] font-normal text-2xl shadow-xs">
                    5
                </button>
                <button onclick="pressDigit('6')" class="keypad-btn h-13 py-2.5 rounded-xl bg-white dark:bg-[#2a2a2a] hover:bg-slate-50 dark:hover:bg-[#333333] text-slate-900 dark:text-[#f2f2f2] font-normal text-2xl shadow-xs">
                    6
                </button>

                <!-- Linha 3 & 4 Esquerda: Bloco de Operações (+ − × ÷) -->
                <div class="row-span-2 grid grid-cols-2 gap-1 rounded-xl bg-white dark:bg-[#2a2a2a] p-1.5 shadow-xs">
                    <button onclick="pressOperator('+')" class="keypad-btn rounded-lg hover:bg-slate-100 dark:hover:bg-[#383838] text-[#e09f5a] font-bold text-xl flex items-center justify-center">+</button>
                    <button onclick="pressOperator('-')" class="keypad-btn rounded-lg hover:bg-slate-100 dark:hover:bg-[#383838] text-[#e09f5a] font-bold text-xl flex items-center justify-center">−</button>
                    <button onclick="pressOperator('*')" class="keypad-btn rounded-lg hover:bg-slate-100 dark:hover:bg-[#383838] text-[#e09f5a] font-bold text-xl flex items-center justify-center">×</button>
                    <button onclick="pressOperator('/')" class="keypad-btn rounded-lg hover:bg-slate-100 dark:hover:bg-[#383838] text-[#e09f5a] font-bold text-xl flex items-center justify-center">÷</button>
                </div>

                <button onclick="pressDigit('1')" class="keypad-btn h-13 py-2.5 rounded-xl bg-white dark:bg-[#2a2a2a] hover:bg-slate-50 dark:hover:bg-[#333333] text-slate-900 dark:text-[#f2f2f2] font-normal text-2xl shadow-xs">
                    1
                </button>
                <button onclick="pressDigit('2')" class="keypad-btn h-13 py-2.5 rounded-xl bg-white dark:bg-[#2a2a2a] hover:bg-slate-50 dark:hover:bg-[#333333] text-slate-900 dark:text-[#f2f2f2] font-normal text-2xl shadow-xs">
                    2
                </button>
                <button onclick="pressDigit('3')" class="keypad-btn h-13 py-2.5 rounded-xl bg-white dark:bg-[#2a2a2a] hover:bg-slate-50 dark:hover:bg-[#333333] text-slate-900 dark:text-[#f2f2f2] font-normal text-2xl shadow-xs">
                    3
                </button>

                <!-- Linha 4 Direita: 0, Vírgula (,), Apagar -->
                <button onclick="pressDigit('0')" class="keypad-btn h-13 py-2.5 rounded-xl bg-white dark:bg-[#2a2a2a] hover:bg-slate-50 dark:hover:bg-[#333333] text-slate-900 dark:text-[#f2f2f2] font-normal text-2xl shadow-xs">
                    0
                </button>
                <button onclick="pressDecimal()" class="keypad-btn h-13 py-2.5 rounded-xl bg-white dark:bg-[#2a2a2a] hover:bg-slate-50 dark:hover:bg-[#333333] text-slate-900 dark:text-[#f2f2f2] font-normal text-2xl shadow-xs">
                    ,
                </button>
                <button onclick="pressBackspace()" class="keypad-btn h-13 py-2.5 rounded-xl bg-white dark:bg-[#2a2a2a] hover:bg-slate-50 dark:hover:bg-[#333333] text-slate-800 dark:text-[#f2f2f2] font-bold text-xl shadow-xs flex items-center justify-center">
                    <i data-lucide="delete" class="w-6 h-6"></i>
                </button>
            </div>
        </div>

        <!-- BARRA INFERIOR DE NAVEGAÇÃO -->
        <nav class="bg-white dark:bg-[#1a1a1a] border-t border-slate-200 dark:border-[#292929] px-2 py-2 grid grid-cols-4 text-xs font-medium shrink-0 z-20">
            <button onclick="focusConverterTab()" id="nav-converter" class="flex flex-col items-center justify-center gap-1 py-1 rounded-xl text-[#4f86c6]">
                <i data-lucide="arrow-left-right" class="w-5 h-5"></i>
                <span>Conversor</span>
            </button>
            <button onclick="openChartModal()" id="nav-charts" class="flex flex-col items-center justify-center gap-1 py-1 rounded-xl text-slate-500 dark:text-[#9a9a9a] hover:text-[#4f86c6] transition">
                <i data-lucide="trending-up" class="w-5 h-5"></i>
                <span>Gráficos</span>
            </button>
            <button onclick="pressEquals()" id="nav-equals" class="flex flex-col items-center justify-center gap-1 py-1 rounded-xl text-[#e09f5a] hover:opacity-80 transition font-bold">
                <i data-lucide="equal" class="w-5 h-5"></i>
                <span>Calcular (=)</span>
            </button>
            <button onclick="openCustomRateModal()" id="nav-rate" class="flex flex-col items-center justify-center gap-1 py-1 rounded-xl text-slate-500 dark:text-[#9a9a9a] hover:text-[#4f86c6] transition">
                <i data-lucide="pencil" class="w-5 h-5"></i>
                <span>Minha taxa</span>
            </button>
        </nav>

        <!-- MODAL: BAIXAR APLICATIVO -->
        <div id="install-help-modal" class="hidden absolute inset-0 z-40 bg-black/70 backdrop-blur-xs flex flex-col justify-end sm:justify-center p-0 sm:p-4">
            <div class="bg-white dark:bg-[#1e1e1e] w-full sm:rounded-2xl rounded-t-2xl p-5 shadow-2xl border border-slate-200 dark:border-[#2e2e2e] space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="p-2 rounded-xl bg-[#4f86c6]/15 text-[#4f86c6]">
                            <i data-lucide="smartphone" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-base text-slate-900 dark:text-white">Baixar Aplicativo</h3>
                            <p class="text-xs text-slate-500">Para celular e tablet (Android / iOS)</p>
                        </div>
                    </div>
                    <button onclick="closeInstallHelpModal()" class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-[#2a2a2a] text-slate-500">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>

                <button id="pwa-direct-install-btn" onclick="triggerPwaInstall()" class="hidden w-full py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm flex items-center justify-center gap-2 shadow-md transition">
                    <i data-lucide="download-cloud" class="w-5 h-5"></i>
                    Instalar Aplicativo Agora
                </button>

                <div class="bg-slate-100 dark:bg-[#141414] rounded-xl p-4 space-y-3 border border-slate-200 dark:border-[#2a2a2a]">
                    <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed text-center">
                        Clique abaixo para baixar o aplicativo diretamente para o seu celular ou tablet:
                    </p>
                    <button onclick="downloadHtmlAppFile()" class="w-full py-3.5 px-4 rounded-xl bg-[#4f86c6] hover:bg-[#5c94d6] text-white text-sm font-bold flex items-center justify-center gap-2 shadow-md transition">
                        <i data-lucide="download" class="w-5 h-5"></i>
                        <span>Baixar Aplicativo</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- MODAL: GERENCIAR MOEDAS -->
        <div id="add-currency-modal" class="hidden absolute inset-0 z-40 bg-black/70 backdrop-blur-xs flex flex-col justify-end sm:justify-center p-0 sm:p-4">
            <div class="bg-white dark:bg-[#1e1e1e] w-full sm:rounded-2xl rounded-t-2xl max-h-[84%] flex flex-col shadow-2xl border border-slate-200 dark:border-[#2e2e2e] overflow-hidden">
                <div class="px-4 py-3.5 border-b border-slate-200 dark:border-[#2c2c2c] flex items-center justify-between">
                    <h3 class="font-bold text-base text-slate-900 dark:text-white">Gerenciar moedas</h3>
                    <button onclick="closeAddCurrencyModal()" class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-[#2a2a2a] text-slate-500">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>
                <div class="p-3 border-b border-slate-200 dark:border-[#2c2c2c]">
                    <input type="text" id="currency-search-input" oninput="renderModalCurrencyList()" placeholder="Buscar moeda (USD, BRL, BTC, ETH, SOL, DOGE, XRP, LTC...)" class="w-full px-3.5 py-2.5 text-sm rounded-xl bg-slate-100 dark:bg-[#141414] border border-slate-300 dark:border-[#333333] focus:outline-none focus:border-[#4f86c6] text-slate-900 dark:text-white">
                </div>
                <div id="modal-currency-list" class="flex-1 overflow-y-auto divide-y divide-slate-100 dark:divide-[#262626] p-2"></div>
            </div>
        </div>

        <!-- MODAL: GRÁFICO HISTÓRICO -->
        <div id="chart-modal" class="hidden absolute inset-0 z-40 bg-black/70 backdrop-blur-xs flex flex-col justify-end sm:justify-center p-0 sm:p-4">
            <div class="bg-white dark:bg-[#1e1e1e] w-full sm:rounded-2xl rounded-t-2xl p-4 shadow-2xl border border-slate-200 dark:border-[#2e2e2e] space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 id="chart-modal-title" class="font-bold text-base text-slate-900 dark:text-white">Histórico USD → BRL</h3>
                        <p id="chart-modal-subtitle" class="text-xs text-slate-500">Variação recente da cotação</p>
                    </div>
                    <button onclick="closeChartModal()" class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-[#2a2a2a] text-slate-500">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>
                <div class="grid grid-cols-4 gap-1.5 bg-slate-100 dark:bg-[#141414] p-1 rounded-xl text-xs font-bold">
                    <button onclick="updateHistoryChart(7, this)" class="chart-range-btn py-1.5 rounded-lg bg-white dark:bg-[#2a2a2a] text-[#4f86c6] shadow-xs">7D</button>
                    <button onclick="updateHistoryChart(30, this)" class="chart-range-btn py-1.5 rounded-lg text-slate-500">1M</button>
                    <button onclick="updateHistoryChart(90, this)" class="chart-range-btn py-1.5 rounded-lg text-slate-500">3M</button>
                    <button onclick="updateHistoryChart(365, this)" class="chart-range-btn py-1.5 rounded-lg text-slate-500">1A</button>
                </div>
                <div class="h-52 w-full">
                    <canvas id="rate-history-canvas"></canvas>
                </div>
            </div>
        </div>

        <!-- MODAL: MINHA TAXA PERSONALIZADA -->
        <div id="custom-rate-modal" class="hidden absolute inset-0 z-40 bg-black/70 backdrop-blur-xs flex flex-col justify-end sm:justify-center p-0 sm:p-4">
            <div class="bg-white dark:bg-[#1e1e1e] w-full sm:rounded-2xl rounded-t-2xl p-5 shadow-2xl border border-slate-200 dark:border-[#2e2e2e] space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="font-bold text-base text-slate-900 dark:text-white">Minha taxa personalizada</h3>
                    <button onclick="closeCustomRateModal()" class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-[#2a2a2a] text-slate-500">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>
                <p class="text-sm text-slate-500 dark:text-slate-400">
                    Defina uma cotação manual para substituir a taxa automática:
                </p>
                <div class="space-y-2">
                    <label id="custom-rate-label" class="text-sm font-bold text-slate-700 dark:text-slate-200 block">1 USD vale quanto em BRL?</label>
                    <input type="number" step="any" id="custom-rate-input" class="w-full px-3.5 py-3 rounded-xl bg-slate-100 dark:bg-[#141414] border border-slate-300 dark:border-[#333333] text-lg font-bold text-slate-900 dark:text-white focus:outline-none focus:border-[#4f86c6]">
                </div>
                <div class="flex items-center justify-between gap-2 pt-1">
                    <button onclick="resetCustomRate()" class="px-4 py-2.5 rounded-xl bg-slate-200 dark:bg-[#2a2a2a] text-sm font-bold text-slate-700 dark:text-slate-300 hover:opacity-90">
                        Restaurar Oficial
                    </button>
                    <button onclick="saveCustomRate()" class="px-5 py-2.5 rounded-xl bg-[#4f86c6] hover:bg-[#5c94d6] text-white text-sm font-bold">
                        Aplicar Taxa
                    </button>
                </div>
            </div>
        </div>

    </div>

    <script>
        // ==========================================
        // BANCO DE MOEDAS, BANDEIRAS & ÍCONES OFICIAIS
        // ==========================================
        const ALL_CURRENCIES = [
            { code: 'BRL', name: 'Real Brasileiro', symbol: 'R$', country: 'br', decimals: 2 },
            { code: 'USD', name: 'Dólar Americano', symbol: '$', country: 'us', decimals: 2 },
