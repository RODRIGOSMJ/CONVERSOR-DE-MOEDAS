                            if (cryptoData.ethereum?.usd) baseRatesUsd.ETH = 1 / cryptoData.ethereum.usd;
                            if (cryptoData.solana?.usd) baseRatesUsd.SOL = 1 / cryptoData.solana.usd;
                            if (cryptoData.dogecoin?.usd) baseRatesUsd.DOGE = 1 / cryptoData.dogecoin.usd;
                            if (cryptoData.ripple?.usd) baseRatesUsd.XRP = 1 / cryptoData.ripple.usd;
                            if (cryptoData.litecoin?.usd) baseRatesUsd.LTC = 1 / cryptoData.litecoin.usd;
                            const polPrice = cryptoData['polygon-ecosystem-token']?.usd || cryptoData['matic-network']?.usd;
                            if (polPrice) baseRatesUsd.POL = 1 / polPrice;
                            if (cryptoData.tron?.usd) baseRatesUsd.TRX = 1 / cryptoData.tron.usd;
                            if (cryptoData.binancecoin?.usd) baseRatesUsd.BNB = 1 / cryptoData.binancecoin.usd;
                            updatedAny = true;
                        }
                    } catch (e) {}
                })();

                await Promise.all([fiatPromise, cryptoPromise]);

                const now = new Date();
                const timeStr = now.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });

                if (updatedAny) {
                    statusText.innerHTML = `<span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse mr-1.5"></span>ONLINE • Atualizado às ${timeStr} (auto 5s)`;
                    saveToStorage();
                    if (!isDraggingRow && !activeDragState) {
                        renderCurrencyRows();
                    }
                    if (manual) showToast('Cotações online atualizadas!');
                } else {
                    statusText.innerHTML = `<span class="inline-block w-2 h-2 rounded-full bg-amber-500 animate-ping mr-1.5"></span>Reconectando servidor online...`;
                    if (manual) showToast('Tentando reconectar às cotações online...');
                }
            } finally {
                isFetchingRates = false;
            }
        }

        function getEffectiveUsdRate(code) {
            if (appState.customRatesUsd[code]) {
                return appState.customRatesUsd[code];
            }
            return baseRatesUsd[code] || 1;
        }

        function getActiveNumericValue() {
            const cleaned = appState.inputString.replace(',', '.');
            const num = parseFloat(cleaned);
            return isNaN(num) ? 0 : num;
        }

        // ==========================================
        // RENDERIZAÇÃO LIMPA E ROBUSTA
        // ==========================================
        function renderCurrencyRows() {
            const container = document.getElementById('currency-list-container');
            const activeValue = getActiveNumericValue();
            const activeUsdRate = getEffectiveUsdRate(appState.activeCode);
            const valueInUsd = activeUsdRate > 0 ? (activeValue / activeUsdRate) : 0;

            const exprBanner = document.getElementById('expression-banner');
            if (appState.pendingOperator && appState.previousValue !== null) {
                const opMap = { '+': '+', '-': '−', '*': '×', '/': '÷' };
                document.getElementById('expr-currency-code').textContent = appState.activeCode;
                document.getElementById('expression-text').textContent = `${formatDisplayNumber(appState.previousValue, 4)} ${opMap[appState.pendingOperator]} ${appState.inputString}`;
                exprBanner.classList.remove('hidden');
            } else {
                exprBanner.classList.add('hidden');
            }

            container.innerHTML = appState.selectedCodes.map(code => {
                const info = ALL_CURRENCIES.find(c => c.code === code) || { code, name: code, symbol: '$', country: 'un', decimals: 2 };
                const isActive = code === appState.activeCode;
                const targetUsdRate = getEffectiveUsdRate(code);
                const isCustom = Boolean(appState.customRatesUsd[code]);
                const iconBadgeHtml = getCurrencyBadgeHtml(info, false);

                let displayValueStr = '';
                if (isActive) {
                    displayValueStr = formatRawInputString(appState.inputString);
                } else {
                    const convertedVal = valueInUsd * targetUsdRate;
                    displayValueStr = formatDisplayNumber(convertedVal, info.decimals);
                }

                return `
                    <div data-code="${code}" onclick="selectActiveCurrency('${code}')" class="currency-row-item pl-2 pr-4 py-3.5 flex items-center justify-between gap-2 cursor-pointer select-none ${isActive ? 'bg-sky-50 dark:bg-[#1f2936]' : 'hover:bg-slate-50 dark:hover:bg-[#1a1a1a]'}">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <div class="drag-handle p-1.5 rounded-lg text-slate-400 hover:text-slate-600 dark:text-[#666666] dark:hover:text-slate-300 shrink-0" title="Segure e arraste para reordenar">
                                <i data-lucide="grip-vertical" class="w-4 h-4"></i>
                            </div>
                            ${iconBadgeHtml}
                            <div class="flex items-center gap-1.5">
                                <span class="text-xl sm:text-[22px] font-medium tracking-wide text-slate-900 dark:text-[#f2f2f2]">${info.code}</span>
                                <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 dark:text-slate-300"></i>
                                ${isCustom ? '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-500">Manual</span>' : ''}
                            </div>
                        </div>

                        <div class="flex items-center gap-2.5 shrink-0">
                            ${isActive ? `
                                <span class="px-2.5 py-0.5 rounded-[4px] bg-[#4b6a8e] text-white text-2xl sm:text-[26px] font-normal tracking-tight leading-snug">
                                    ${displayValueStr}
                                </span>
                            ` : `
                                <span class="text-2xl sm:text-[26px] font-normal tracking-tight text-slate-900 dark:text-[#ececec]">
                                    ${displayValueStr}
                                </span>
                            `}

                            <button onclick="event.stopPropagation(); openChartForPair('${appState.activeCode}', '${code}')" class="p-1.5 rounded-lg text-slate-400 hover:text-[#4f86c6] transition" title="Ver gráfico ${appState.activeCode}/${code}">
                                <i data-lucide="trending-up" class="w-5 h-5"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            attachDragReorderHandlers();
            safeCreateIcons();
        }

        // ==========================================
        // ARRASTAR E SOLTAR MOEDAS (TOQUE & MOUSE)
        // ==========================================
        let isDraggingRow = false;
        let suppressNextRowClick = false;
        let activeDragState = null;

        function attachDragReorderHandlers() {
            const container = document.getElementById('currency-list-container');
            const rows = Array.from(container.querySelectorAll('.currency-row-item'));

            rows.forEach(row => {
                let pressTimer = null;
                let startY = 0;

                const beginDrag = () => {
                    isDraggingRow = true;
                    suppressNextRowClick = true;
                    activeDragState = {
                        row,
                        rows,
                        hoverRow: null
                    };
                    row.classList.add('currency-row-dragging', 'bg-sky-100', 'dark:bg-[#253242]');
                    if (navigator.vibrate) navigator.vibrate(25);
                };

                const onPointerDown = (e) => {
                    if (e.target.closest('button')) return;
                    const isHandle = Boolean(e.target.closest('.drag-handle'));
                    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                    startY = clientY;

                    if (isHandle) {
                        if (e.cancelable) e.preventDefault();
                        beginDrag();
                    } else {
                        pressTimer = setTimeout(beginDrag, 220);
                    }
                };

                const cancelPressTimer = (e) => {
                    if (!pressTimer) return;
                    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                    if (Math.abs(clientY - startY) > 8) {
                        clearTimeout(pressTimer);
                        pressTimer = null;
                    }
                };

                const clearPressTimerOnly = () => {
                    if (pressTimer) {
                        clearTimeout(pressTimer);
                        pressTimer = null;
                    }
                };

                row.addEventListener('mousedown', onPointerDown);
                row.addEventListener('mousemove', cancelPressTimer);
                row.addEventListener('mouseup', clearPressTimerOnly);

                row.addEventListener('touchstart', onPointerDown, { passive: false });
                row.addEventListener('touchmove', cancelPressTimer, { passive: true });
                row.addEventListener('touchend', clearPressTimerOnly);
                row.addEventListener('touchcancel', clearPressTimerOnly);
            });
        }

        function handleGlobalDragMove(e) {
            if (!activeDragState) return;
            if (e.cancelable) e.preventDefault();

            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            const { row, rows } = activeDragState;

            rows.forEach(r => r.classList.remove('currency-row-over'));
            const targetRow = rows.find(r => {
                if (r === row) return false;
                const rect = r.getBoundingClientRect();
                return clientY >= rect.top && clientY <= rect.bottom;
            });

            activeDragState.hoverRow = targetRow || null;
            if (targetRow) {
                targetRow.classList.add('currency-row-over');
            }
        }

        function handleGlobalDragEnd() {
            if (!activeDragState) return;

            const { row, rows, hoverRow } = activeDragState;
            row.classList.remove('currency-row-dragging', 'bg-sky-100', 'dark:bg-[#253242]');
            rows.forEach(r => r.classList.remove('currency-row-over'));

            if (hoverRow) {
                const fromCode = row.dataset.code;
                const toCode = hoverRow.dataset.code;
                const fromIdx = appState.selectedCodes.indexOf(fromCode);
                const toIdx = appState.selectedCodes.indexOf(toCode);

                if (fromIdx !== -1 && toIdx !== -1 && fromIdx !== toIdx) {
                    appState.selectedCodes.splice(fromIdx, 1);
                    appState.selectedCodes.splice(toIdx, 0, fromCode);
                    saveToStorage();
                    renderCurrencyRows();
                    showToast(`${fromCode} movido!`);
                }
            }

            activeDragState = null;
            isDraggingRow = false;
            setTimeout(() => { suppressNextRowClick = false; }, 140);
        }

        window.addEventListener('mousemove', handleGlobalDragMove);
        window.addEventListener('mouseup', handleGlobalDragEnd);
        window.addEventListener('touchmove', handleGlobalDragMove, { passive: false });
        window.addEventListener('touchend', handleGlobalDragEnd);
        window.addEventListener('touchcancel', handleGlobalDragEnd);

        // ==========================================
        // PULL-TO-REFRESH (PUXAR PARA BAIXO PARA ATUALIZAR)
        // ==========================================
        function initPullToRefresh() {
            const container = document.getElementById('currency-list-container');
            const indicator = document.getElementById('pull-refresh-indicator');
            const icon = document.getElementById('pull-refresh-icon');
            const label = document.getElementById('pull-refresh-label');
            if (!container || !indicator) return;

            let pullStartY = null;
            let currentPull = 0;
            let isRefreshing = false;
            let didPullGesture = false;
            const TRIGGER_THRESHOLD = 62;

            const resetIndicator = () => {
                indicator.style.height = '0px';
                indicator.style.opacity = '0';
                if (icon) {
                    icon.classList.remove('animate-spin');
                    icon.style.transform = 'rotate(0deg)';
                }
                pullStartY = null;
                currentPull = 0;
                if (didPullGesture) {
                    suppressNextRowClick = true;
                    setTimeout(() => { suppressNextRowClick = false; }, 180);
                    didPullGesture = false;
                }
            };

            container.addEventListener('touchstart', (e) => {
                if (isDraggingRow || activeDragState || isRefreshing) return;
                if (container.scrollTop <= 0 && e.touches.length === 1) {
                    pullStartY = e.touches[0].clientY;
                    didPullGesture = false;
                } else {
                    pullStartY = null;
                }
            }, { passive: true });

            container.addEventListener('touchmove', (e) => {
                if (pullStartY === null || isDraggingRow || activeDragState || isRefreshing) return;
                if (container.scrollTop > 0) {
                    resetIndicator();
                    return;
                }

                const deltaY = e.touches[0].clientY - pullStartY;
                if (deltaY > 10) {
                    if (e.cancelable) e.preventDefault();
                    didPullGesture = true;
                    suppressNextRowClick = true;
                    currentPull = Math.min(84, deltaY * 0.55);
                    indicator.style.height = `${currentPull}px`;
                    indicator.style.opacity = Math.min(1, currentPull / 45).toString();

                    if (icon) {
                        icon.style.transform = `rotate(${Math.round(currentPull * 4)}deg)`;
                    }
                    if (label) {
                        label.textContent = currentPull >= TRIGGER_THRESHOLD
                            ? 'Solte para atualizar agora'
                            : 'Puxe para atualizar cotações';
                    }
                }
            }, { passive: false });

            const finishPull = async () => {
                if (pullStartY === null) return;
                const shouldRefresh = currentPull >= TRIGGER_THRESHOLD && !isRefreshing;
                pullStartY = null;

                if (shouldRefresh) {
                    isRefreshing = true;
                    suppressNextRowClick = true;
                    indicator.style.height = '44px';
                    indicator.style.opacity = '1';
                    if (icon) icon.classList.add('animate-spin');
                    if (label) label.textContent = 'Atualizando cotações ao vivo...';

                    if (navigator.vibrate) navigator.vibrate(20);
                    await fetchLiveRates(true);

                    setTimeout(() => {
                        isRefreshing = false;
                        resetIndicator();
                    }, 350);
                } else {
                    resetIndicator();
                }
            };

            container.addEventListener('touchend', finishPull);
            container.addEventListener('touchcancel', finishPull);
        }

        function selectActiveCurrency(code) {
            if (suppressNextRowClick || isDraggingRow) return;
            if (appState.activeCode === code) {
                appState.resetOnNextDigit = true;
                renderCurrencyRows();
                return;
            }

            const activeValue = getActiveNumericValue();
            const activeUsdRate = getEffectiveUsdRate(appState.activeCode);
            const valueInUsd = activeUsdRate > 0 ? (activeValue / activeUsdRate) : 0;
            const newUsdRate = getEffectiveUsdRate(code);
            const convertedVal = valueInUsd * newUsdRate;

            appState.activeCode = code;
            appState.inputString = formatNumberToInput(convertedVal);
            appState.pendingOperator = null;
            appState.previousValue = null;
            appState.resetOnNextDigit = true;
            saveToStorage();
            renderCurrencyRows();
        }

        function swapTopTwoCurrencies() {
            if (appState.selectedCodes.length < 2) return;
            const [first, second] = appState.selectedCodes;
            appState.selectedCodes[0] = second;
            appState.selectedCodes[1] = first;
            const nextActive = appState.activeCode === first ? second : first;
            saveToStorage();
            selectActiveCurrency(nextActive);
        }

        // ==========================================
        // TECLADO & CALCULADORA
        // ==========================================
        function pressDigit(digit) {
            if (appState.resetOnNextDigit) {
                appState.inputString = digit;
                appState.resetOnNextDigit = false;
            } else if (appState.inputString === '0') {
                appState.inputString = digit;
            } else if (appState.inputString.replace(',', '').length < 14) {
                appState.inputString += digit;
            }
            saveToStorage();
            renderCurrencyRows();
        }

        function pressDecimal() {
            if (appState.resetOnNextDigit) {
                appState.inputString = '0,';
                appState.resetOnNextDigit = false;
            } else if (!appState.inputString.includes(',')) {
                appState.inputString += ',';
            }
            saveToStorage();
            renderCurrencyRows();
        }

        function pressBackspace() {
            if (appState.resetOnNextDigit) {
                appState.inputString = '0';
                appState.resetOnNextDigit = false;
            } else if (appState.inputString.length <= 1) {
                appState.inputString = '0';
            } else {
                appState.inputString = appState.inputString.slice(0, -1);
            }
            saveToStorage();
            renderCurrencyRows();
        }

        function pressClear() {
            appState.inputString = '0';
            appState.pendingOperator = null;
            appState.previousValue = null;
            appState.resetOnNextDigit = false;
            saveToStorage();
            renderCurrencyRows();
        }

        function pressOperator(op) {
            const currentVal = getActiveNumericValue();
            if (appState.pendingOperator && appState.previousValue !== null && !appState.resetOnNextDigit) {
                const evaluated = computeOperation(appState.previousValue, currentVal, appState.pendingOperator);
                appState.previousValue = evaluated;
                appState.inputString = formatNumberToInput(evaluated);
            } else {
                appState.previousValue = currentVal;
            }
            appState.pendingOperator = op;
            appState.resetOnNextDigit = true;
            saveToStorage();
            renderCurrencyRows();
        }

        function pressEquals() {
            if (!appState.pendingOperator || appState.previousValue === null) {
                appState.resetOnNextDigit = true;
                saveToStorage();
                renderCurrencyRows();
                return;
            }
            const currentVal = getActiveNumericValue();
            const result = computeOperation(appState.previousValue, currentVal, appState.pendingOperator);
            appState.inputString = formatNumberToInput(result);
            appState.pendingOperator = null;
            appState.previousValue = null;
            appState.resetOnNextDigit = true;
            saveToStorage();
            renderCurrencyRows();
        }

        function computeOperation(a, b, op) {
            switch (op) {
                case '+': return a + b;
                case '-': return a - b;
                case '*': return a * b;
                case '/': return b !== 0 ? a / b : 0;
                default: return b;
            }
        }

        function formatNumberToInput(num) {
            if (!isFinite(num)) return '0';
            const rounded = Math.round(num * 1000000) / 1000000;
            return rounded.toString().replace('.', ',');
        }

        function formatRawInputString(raw) {
            const parts = raw.split(',');
            const intPart = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
            return parts.length > 1 ? `${intPart},${parts[1]}` : intPart;
        }

        function formatDisplayNumber(num, maxDecimals = 2) {
            if (!isFinite(num) || num === 0) return '0,00';
            const decimals = Math.abs(num) < 0.01 ? Math.max(maxDecimals, 6) : maxDecimals;
            return num.toLocaleString('pt-BR', {
                minimumFractionDigits: Math.min(2, decimals),
                maximumFractionDigits: decimals
            });
        }

        function initPhysicalKeyboard() {
            window.addEventListener('keydown', (e) => {
                if (e.target.tagName === 'INPUT') return;
                if (e.key >= '0' && e.key <= '9') pressDigit(e.key);
                else if (e.key === ',' || e.key === '.') pressDecimal();
                else if (e.key === 'Backspace') pressBackspace();
                else if (e.key === 'Escape' || e.key.toLowerCase() === 'c') pressClear();
                else if (e.key === '+' || e.key === '-' || e.key === '*' || e.key === '/') pressOperator(e.key);
                else if (e.key === 'Enter' || e.key === '=') {
                    e.preventDefault();
                    pressEquals();
                }
            });
        }

        // ==========================================
        // CONTROLE DE TECLADO RETRÁTIL & TEMA
        // ==========================================
        function toggleKeypad() {
            appState.keypadExpanded = !appState.keypadExpanded;
            const drawer = document.getElementById('keypad-drawer');
            const chevron = document.getElementById('keypad-chevron');

            if (appState.keypadExpanded) {
                drawer.style.maxHeight = '340px';
                drawer.style.opacity = '1';
                chevron.style.transform = 'rotate(0deg)';
            } else {
                drawer.style.maxHeight = '0px';
                drawer.style.opacity = '0';
                chevron.style.transform = 'rotate(180deg)';
            }
        }

        function toggleTheme() {
            const html = document.documentElement;
            const isDark = html.classList.toggle('dark');
            const icon = document.getElementById('theme-icon');
            if (icon) {
                icon.setAttribute('data-lucide', isDark ? 'sun' : 'moon');
                safeCreateIcons();
            }
        }

        function focusConverterTab() {
            closeAddCurrencyModal();
            closeChartModal();
            closeCustomRateModal();
            closeInstallHelpModal();
        }

        // ==========================================
        // MODAIS: GERENCIAR MOEDAS, GRÁFICO & MINHA TAXA
        // ==========================================
        function openAddCurrencyModal() {
            document.getElementById('add-currency-modal').classList.remove('hidden');
            renderModalCurrencyList();
            safeCreateIcons();
        }

        function closeAddCurrencyModal() {
            document.getElementById('add-currency-modal').classList.add('hidden');
        }

        function renderModalCurrencyList() {
            const query = (document.getElementById('currency-search-input')?.value || '').trim().toLowerCase();
            const listEl = document.getElementById('modal-currency-list');
            const filtered = ALL_CURRENCIES.filter(c =>
                c.code.toLowerCase().includes(query) || c.name.toLowerCase().includes(query)
            );

            listEl.innerHTML = filtered.map(c => {
                const isSelected = appState.selectedCodes.includes(c.code);
                return `
                    <button onclick="toggleCurrencyInList('${c.code}')" class="w-full px-3.5 py-3 flex items-center justify-between hover:bg-slate-100 dark:hover:bg-[#262626] rounded-xl transition text-left">
                        <div class="flex items-center gap-3">
                            ${getCurrencyBadgeHtml(c, true)}
                            <div>
                                <div class="font-bold text-sm text-slate-900 dark:text-white">${c.code}</div>
                                <div class="text-xs text-slate-500">${c.name}</div>
                            </div>
                        </div>
                        <span class="text-xs font-bold px-3 py-1 rounded-lg ${isSelected ? 'bg-[#4f86c6]/20 text-[#4f86c6]' : 'bg-slate-200 dark:bg-[#2a2a2a] text-slate-400'}">
                            ${isSelected ? 'Ativa ✓' : '+ Adicionar'}
                        </span>
                    </button>
                `;
            }).join('');
        }

        function toggleCurrencyInList(code) {
            const idx = appState.selectedCodes.indexOf(code);
            if (idx !== -1) {
                if (appState.selectedCodes.length <= 2) {
                    showToast('Mantenha pelo menos 2 moedas na lista.');
                    return;
                }
                appState.selectedCodes.splice(idx, 1);
                if (appState.activeCode === code) {
                    appState.activeCode = appState.selectedCodes[0];
                }
            } else {
                appState.selectedCodes.push(code);
            }
            saveToStorage();
            renderModalCurrencyList();
            renderCurrencyRows();
