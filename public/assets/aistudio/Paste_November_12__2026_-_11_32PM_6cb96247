                            const list = await bRes.json();
                            if (Array.isArray(list)) {
                                list.forEach(item => {
                                    const p = parseFloat(item.price);
                                    if (!(p > 0)) return;
                                    if (item.symbol === 'BTCUSDT') baseRatesUsd.BTC = 1 / p;
