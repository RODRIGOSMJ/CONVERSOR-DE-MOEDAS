                                    else if (item.symbol === 'POLUSDT') baseRatesUsd.POL = 1 / p;
                                    else if (item.symbol === 'TRXUSDT') baseRatesUsd.TRX = 1 / p;
                                    else if (item.symbol === 'BNBUSDT') baseRatesUsd.BNB = 1 / p;
                                });
                                updatedAny = true;
