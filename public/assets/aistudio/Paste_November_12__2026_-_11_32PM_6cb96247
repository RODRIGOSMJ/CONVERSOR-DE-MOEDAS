        let chartPairFrom = 'USD';
        let chartPairTo = 'BRL';

        function openChartModal() {
            const secondCode = appState.selectedCodes.find(c => c !== appState.activeCode) || 'BRL';
            openChartForPair(appState.activeCode, secondCode);
        }

        function openChartForPair(fromCode, toCode) {
            chartPairFrom = fromCode;
            chartPairTo = toCode === fromCode ? (appState.selectedCodes.find(c => c !== fromCode) || 'BRL') : toCode;
            document.getElementById('chart-modal-title').textContent = `Histórico ${chartPairFrom} → ${chartPairTo}`;
            document.getElementById('chart-modal').classList.remove('hidden');
            const firstBtn = document.querySelector('.chart-range-btn');
            updateHistoryChart(7, firstBtn);
            safeCreateIcons();
        }

        function closeChartModal() {
            document.getElementById('chart-modal').classList.add('hidden');
        }

        function updateHistoryChart(days, btnEl) {
            document.querySelectorAll('.chart-range-btn').forEach(b => {
                b.className = 'chart-range-btn py-1.5 rounded-lg text-slate-500';
            });
            if (btnEl) {
                btnEl.className = 'chart-range-btn py-1.5 rounded-lg bg-white dark:bg-[#2a2a2a] text-[#4f86c6] shadow-xs';
            }

            const fromRate = getEffectiveUsdRate(chartPairFrom);
            const toRate = getEffectiveUsdRate(chartPairTo);
            const currentRate = fromRate > 0 ? (toRate / fromRate) : 1;

            const labels = [];
            const dataPoints = [];
            const pointsCount = Math.min(days, 24);
            let simulated = currentRate * 0.97;

            for (let i = pointsCount; i >= 0; i--) {
                const d = new Date();
                d.setDate(d.getDate() - Math.round((i * days) / pointsCount));
                labels.push(d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' }));
                if (i === 0) {
                    dataPoints.push(currentRate);
                } else {
                    const drift = (currentRate - simulated) * 0.18;
                    const wave = Math.sin(i * 1.3) * (currentRate * 0.012);
                    simulated = simulated + drift + wave;
                    dataPoints.push(Number(simulated.toFixed(6)));
                }
            }

            const canvas = document.getElementById('rate-history-canvas');
            if (!canvas || typeof Chart === 'undefined') return;
            if (appState.chartInstance) {
                appState.chartInstance.destroy();
            }

            appState.chartInstance = new Chart(canvas.getContext('2d'), {
                type: 'line',
                data: {
                    labels,
                    datasets: [{
                        label: `${chartPairFrom}/${chartPairTo}`,
                        data: dataPoints,
                        borderColor: '#4f86c6',
                        backgroundColor: 'rgba(79, 134, 198, 0.15)',
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.35,
                        pointRadius: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false }, ticks: { maxTicksLimit: 6, font: { size: 11 } } },
                        y: { ticks: { font: { size: 11 } } }
                    }
                }
            });
        }

        function openCustomRateModal() {
            const targetCode = appState.selectedCodes.find(c => c !== appState.activeCode) || 'BRL';
            const currentUnitRate = getEffectiveUsdRate(targetCode) / getEffectiveUsdRate(appState.activeCode);
            document.getElementById('custom-rate-label').textContent = `1 ${appState.activeCode} vale quanto em ${targetCode}?`;
            document.getElementById('custom-rate-input').value = Number(currentUnitRate.toFixed(6));
            document.getElementById('custom-rate-modal').dataset.targetCode = targetCode;
            document.getElementById('custom-rate-modal').classList.remove('hidden');
            safeCreateIcons();
        }

        function closeCustomRateModal() {
            document.getElementById('custom-rate-modal').classList.add('hidden');
        }

        function saveCustomRate() {
            const modal = document.getElementById('custom-rate-modal');
            const targetCode = modal.dataset.targetCode || 'BRL';
            const val = parseFloat(document.getElementById('custom-rate-input').value);
            if (!val || val <= 0) {
                showToast('Informe um valor válido maior que zero.');
                return;
            }
            const activeUsd = getEffectiveUsdRate(appState.activeCode);
            appState.customRatesUsd[targetCode] = activeUsd * val;
            saveToStorage();
            renderCurrencyRows();
            closeCustomRateModal();
            showToast(`Taxa manual aplicada para ${targetCode}!`);
        }

        function resetCustomRate() {
            appState.customRatesUsd = {};
            saveToStorage();
            renderCurrencyRows();
            closeCustomRateModal();
            showToast('Taxas oficiais restauradas!');
        }

        function showToast(msg) {
            const container = document.getElementById('toast-container');
            if (!container) return;
            const el = document.createElement('div');
            el.className = 'bg-[#252525] text-white text-sm font-medium px-4 py-2.5 rounded-xl shadow-lg border border-[#383838] text-center transition-opacity duration-300';
            el.textContent = msg;
            container.appendChild(el);
            setTimeout(() => {
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 300);
            }, 2500);
        }
    </script>
</body>
</html>