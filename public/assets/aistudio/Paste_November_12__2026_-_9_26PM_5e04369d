<!DOCTYPE html>
<html lang="pt-BR" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#2b6cb0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Conversor Plus">
    <title>Conversor de Moedas Plus</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <!-- Chart.js para histórico de cotações -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- JSZip para empacotar a pasta pronta para o Netlify Drop -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <!-- Fonte Inter & JetBrains Mono -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Estilo fiel ao Conversor de Moedas Plus (Digitalchemy) */
        body {
            overscroll-behavior-y: contain;
            -webkit-tap-highlight-color: transparent;
        }
        .keypad-btn {
            transition: background-color 0.1s ease, transform 0.08s ease;
            user-select: none;
        }
        .keypad-btn:active {
            transform: scale(0.95);
        }
        /* Barra de rolagem discreta na lista de moedas */
        .currency-scroll::-webkit-scrollbar {
            width: 4px;
        }
        .currency-scroll::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.35);
            border-radius: 9999px;
        }
        /* Animação suave do teclado retrátil */
        #keypad-drawer {
            transition: max-height 0.28s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease;
        }
        /* Estilo ao segurar e arrastar uma moeda na lista */
        .currency-row-item {
            transition: background-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
        }
        .currency-row-dragging {
            opacity: 0.92;
            transform: scale(1.02);
            box-shadow: 0 12px 28px -6px rgba(2, 132, 199, 0.35);
            z-index: 30;
            position: relative;
        }
        .currency-row-over {
            border-top: 2px solid #0284c7 !important;
        }
    </style>
</head>
<body class="bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans antialiased h-screen overflow-hidden flex items-center justify-center">

    <!-- Container de Toast -->
    <div id="toast-container" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 max-w-xs w-full pointer-events-none px-4"></div>

    <!-- Moldura Estilo Smartphone / App Mobile Responsivo -->
    <div class="w-full h-full sm:h-[94vh] sm:max-w-[440px] bg-white dark:bg-[#12161f] sm:rounded-[28px] sm:border sm:border-slate-300 dark:sm:border-slate-800 shadow-2xl flex flex-col overflow-hidden relative">

        <!-- TOP BAR DO APP (Estilo Digitalchemy) -->
        <header class="bg-[#2b6cb0] dark:bg-[#1a2232] text-white px-4 py-3 flex items-center justify-between shrink-0 shadow-md z-20">
            <div class="flex items-center gap-2.5">
                <!-- Ícone inspirado no app da Play Store -->
                <div class="w-8 h-8 rounded-lg bg-slate-100 p-1 flex flex-col justify-between shadow-inner shrink-0">
                    <div class="bg-sky-400 text-[7px] font-mono font-extrabold text-slate-900 text-right px-0.5 rounded-[2px] leading-tight">100</div>
                    <div class="grid grid-cols-3 gap-[1.5px] h-4">
                        <div class="bg-slate-300 rounded-[1px] text-[6px] text-slate-700 flex items-center justify-center font-bold">$</div>
                        <div class="bg-slate-300 rounded-[1px] text-[6px] text-slate-700 flex items-center justify-center font-bold">€</div>
                        <div class="row-span-2 bg-orange-500 rounded-[1px] text-[7px] text-white flex items-center justify-center font-bold">=</div>
                        <div class="bg-slate-300 rounded-[1px] text-[6px] text-slate-700 flex items-center justify-center font-bold">£</div>
                        <div class="bg-slate-300 rounded-[1px] text-[6px] text-slate-700 flex items-center justify-center font-bold">¥</div>
                    </div>
                </div>
                <div>
                    <h1 class="font-bold text-sm sm:text-base leading-tight tracking-tight">Conversor de Moedas Plus</h1>
                    <p id="sync-status-text" class="text-[10px] text-sky-100 dark:text-slate-400 flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-pulse"></span>
                        Taxas ao vivo • Offline pronto
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-1">
                <button onclick="openInstallHelpModal()" class="flex items-center gap-1 px-2.5 py-1.5 rounded-full bg-orange-500 hover:bg-orange-400 text-white text-[11px] font-bold shadow-sm transition mr-0.5" title="Baixar aplicativo para celular e tablet">
                    <i data-lucide="download" class="w-3.5 h-3.5"></i>
                    <span>Baixar Aplicativo</span>
                </button>
                <button onclick="fetchLiveRates(true)" class="p-2 rounded-full hover:bg-white/15 transition" title="Atualizar cotações">
                    <i data-lucide="refresh-cw" id="header-refresh-icon" class="w-4 h-4"></i>
                </button>
                <button onclick="openAddCurrencyModal()" class="p-2 rounded-full hover:bg-white/15 transition" title="Adicionar moeda na lista">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                </button>
                <button onclick="toggleTheme()" class="p-2 rounded-full hover:bg-white/15 transition" title="Alternar tema Claro/Escuro">
                    <i data-lucide="moon" id="theme-icon" class="w-4 h-4"></i>
                </button>
            </div>
        </header>

        <!-- BARRA DE EXPRESSÃO MATEMÁTICA ATIVA (Aparece quando há operação como 100 + 25) -->
        <div id="expression-banner" class="hidden bg-sky-50 dark:bg-slate-900/90 border-b border-sky-200 dark:border-slate-800 px-4 py-1.5 flex items-center justify-between text-xs shrink-0">
            <span class="text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
                <i data-lucide="calculator" class="w-3.5 h-3.5 text-sky-600 dark:text-sky-400"></i>
                Conta em <strong id="expr-currency-code" class="text-slate-800 dark:text-slate-200">USD</strong>:
            </span>
            <span id="expression-text" class="font-mono font-bold text-sky-700 dark:text-sky-400">100 + 50</span>
        </div>

        <!-- LISTA DE MOEDAS SIMULTÂNEAS (Parte superior — expande ao recolher o teclado!) -->
        <div id="currency-list-container" class="flex-1 overflow-y-auto currency-scroll divide-y divide-slate-200/80 dark:divide-slate-800/80 bg-white dark:bg-[#12161f]">
            <!-- Linhas geradas dinamicamente pelo JS -->
        </div>

        <!-- DICA FLUTUANTE / BOTÃO RECOLHER OU ABRIR TECLADO (Destaque da imagem: "Recolha o teclado e veja mais moedas") -->
        <div class="bg-slate-100 dark:bg-[#181e2c] border-t border-slate-200 dark:border-slate-800 px-3 py-1.5 flex items-center justify-between shrink-0 z-10">
            <button onclick="toggleKeypad()" class="flex items-center gap-1.5 text-xs font-semibold text-sky-700 dark:text-sky-400 hover:opacity-80 transition py-0.5 px-2 rounded-lg bg-sky-500/10">
                <i data-lucide="chevron-down" id="keypad-chevron" class="w-4 h-4 transition-transform duration-200"></i>
                <span id="keypad-toggle-label">Recolher teclado (ver mais moedas)</span>
            </button>

            <button onclick="openAddCurrencyModal()" class="text-[11px] font-semibold text-slate-600 dark:text-slate-300 hover:text-sky-600 flex items-center gap-1 px-2 py-0.5">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i> Moeda
            </button>
        </div>

        <!-- TECLADO NUMÉRICO & CALCULADORA RETRÁTIL (Fiel à imagem da Play Store) -->
        <div id="keypad-drawer" class="bg-[#e8edf2] dark:bg-[#161b26] shrink-0 overflow-hidden max-h-[340px] opacity-100">
            <div class="p-2 grid grid-cols-4 gap-1.5 font-mono">
                <!-- Linha 1: C (vermelho/coral), ÷, ×, Backspace -->
                <button onclick="pressClear()" class="keypad-btn h-12 rounded-xl bg-white dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-slate-700 text-rose-600 dark:text-rose-400 font-sans font-extrabold text-lg shadow-sm border border-slate-200/80 dark:border-slate-700/70">
                    C
                </button>
                <button onclick="pressOperator('/')" class="keypad-btn h-12 rounded-xl bg-[#dce4ec] dark:bg-slate-800/90 hover:bg-slate-300 dark:hover:bg-slate-700 text-sky-700 dark:text-sky-400 font-bold text-xl shadow-sm border border-slate-300/60 dark:border-slate-700/70">
                    ÷
                </button>
                <button onclick="pressOperator('*')" class="keypad-btn h-12 rounded-xl bg-[#dce4ec] dark:bg-slate-800/90 hover:bg-slate-300 dark:hover:bg-slate-700 text-sky-700 dark:text-sky-400 font-bold text-xl shadow-sm border border-slate-300/60 dark:border-slate-700/70">
                    ×
                </button>
                <button onclick="pressBackspace()" class="keypad-btn h-12 rounded-xl bg-[#dce4ec] dark:bg-slate-800/90 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-lg shadow-sm border border-slate-300/60 dark:border-slate-700/70 flex items-center justify-center">
                    <i data-lucide="delete" class="w-5 h-5"></i>
                </button>

                <!-- Linha 2: 7, 8, 9, − -->
                <button onclick="pressDigit('7')" class="keypad-btn h-12 rounded-xl bg-white dark:bg-[#1f2636] hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-white font-semibold text-xl shadow-sm border border-slate-200/80 dark:border-slate-800">
                    7
                </button>
                <button onclick="pressDigit('8')" class="keypad-btn h-12 rounded-xl bg-white dark:bg-[#1f2636] hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-white font-semibold text-xl shadow-sm border border-slate-200/80 dark:border-slate-800">
                    8
                </button>
                <button onclick="pressDigit('9')" class="keypad-btn h-12 rounded-xl bg-white dark:bg-[#1f2636] hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-white font-semibold text-xl shadow-sm border border-slate-200/80 dark:border-slate-800">
                    9
                </button>
                <button onclick="pressOperator('-')" class="keypad-btn h-12 rounded-xl bg-[#dce4ec] dark:bg-slate-800/90 hover:bg-slate-300 dark:hover:bg-slate-700 text-sky-700 dark:text-sky-400 font-bold text-xl shadow-sm border border-slate-300/60 dark:border-slate-700/70">
                    −
                </button>

                <!-- Linha 3: 4, 5, 6, + -->
                <button onclick="pressDigit('4')" class="keypad-btn h-12 rounded-xl bg-white dark:bg-[#1f2636] hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-white font-semibold text-xl shadow-sm border border-slate-200/80 dark:border-slate-800">
                    4
                </button>
                <button onclick="pressDigit('5')" class="keypad-btn h-12 rounded-xl bg-white dark:bg-[#1f2636] hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-white font-semibold text-xl shadow-sm border border-slate-200/80 dark:border-slate-800">
                    5
                </button>
                <button onclick="pressDigit('6')" class="keypad-btn h-12 rounded-xl bg-white dark:bg-[#1f2636] hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-white font-semibold text-xl shadow-sm border border-slate-200/80 dark:border-slate-800">
                    6
                </button>
                <button onclick="pressOperator('+')" class="keypad-btn h-12 rounded-xl bg-[#dce4ec] dark:bg-slate-800/90 hover:bg-slate-300 dark:hover:bg-slate-700 text-sky-700 dark:text-sky-400 font-bold text-xl shadow-sm border border-slate-300/60 dark:border-slate-700/70">
                    +
                </button>

                <!-- Linha 4: 1, 2, 3, = (Laranja icônico do Conversor Plus!) -->
                <button onclick="pressDigit('1')" class="keypad-btn h-12 rounded-xl bg-white dark:bg-[#1f2636] hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-white font-semibold text-xl shadow-sm border border-slate-200/80 dark:border-slate-800">
                    1
                </button>
                <button onclick="pressDigit('2')" class="keypad-btn h-12 rounded-xl bg-white dark:bg-[#1f2636] hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-white font-semibold text-xl shadow-sm border border-slate-200/80 dark:border-slate-800">
                    2
                </button>
                <button onclick="pressDigit('3')" class="keypad-btn h-12 rounded-xl bg-white dark:bg-[#1f2636] hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-white font-semibold text-xl shadow-sm border border-slate-200/80 dark:border-slate-800">
                    3
                </button>
                <button onclick="pressEquals()" class="keypad-btn row-span-2 rounded-xl bg-gradient-to-b from-orange-500 to-orange-600 hover:from-orange-400 hover:to-orange-500 text-white font-bold text-2xl shadow-md shadow-orange-500/25 flex items-center justify-center">
                    =
                </button>

                <!-- Linha 5: Inverter / Swap (⇄), 0, . -->
                <button onclick="swapTopTwoCurrencies()" class="keypad-btn h-12 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-sky-600 dark:text-sky-400 font-bold text-lg shadow-sm border border-slate-200/80 dark:border-slate-700/70 flex items-center justify-center" title="Inverter moedas principais">
                    <i data-lucide="arrow-up-down" class="w-5 h-5"></i>
                </button>
                <button onclick="pressDigit('0')" class="keypad-btn h-12 rounded-xl bg-white dark:bg-[#1f2636] hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-white font-semibold text-xl shadow-sm border border-slate-200/80 dark:border-slate-800">
                    0
                </button>
                <button onclick="pressDecimal()" class="keypad-btn h-12 rounded-xl bg-white dark:bg-[#1f2636] hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-white font-bold text-xl shadow-sm border border-slate-200/80 dark:border-slate-800">
                    ,
                </button>
            </div>
        </div>

        <!-- BARRA INFERIOR DE NAVEGAÇÃO (Idêntica à screenshot: Converter | Charts | My Rate | Tip/Calc) -->
        <nav class="bg-white dark:bg-[#12161f] border-t border-slate-200 dark:border-slate-800 px-2 py-1.5 grid grid-cols-4 text-[10px] font-semibold shrink-0 z-20">
            <button onclick="focusConverterTab()" id="nav-converter" class="flex flex-col items-center justify-center gap-0.5 py-1 rounded-xl text-sky-600 dark:text-sky-400">
                <i data-lucide="arrow-left-right" class="w-4 h-4"></i>
                <span>Converter</span>
            </button>
            <button onclick="openChartModal()" id="nav-charts" class="flex flex-col items-center justify-center gap-0.5 py-1 rounded-xl text-slate-500 dark:text-slate-400 hover:text-sky-600 transition">
                <i data-lucide="trending-up" class="w-4 h-4"></i>
                <span>Gráficos</span>
            </button>
            <button onclick="openCustomRateModal()" id="nav-rate" class="flex flex-col items-center justify-center gap-0.5 py-1 rounded-xl text-slate-500 dark:text-slate-400 hover:text-sky-600 transition">
                <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                <span>Minha Taxa</span>
            </button>
            <button onclick="pressPercent()" id="nav-percent" class="flex flex-col items-center justify-center gap-0.5 py-1 rounded-xl text-slate-500 dark:text-slate-400 hover:text-sky-600 transition">
                <i data-lucide="percent" class="w-4 h-4"></i>
                <span>Desconto %</span>
            </button>
        </nav>

        <!-- ========================================== -->
        <!-- MODAL: BAIXAR APLICATIVO                   -->
        <!-- ========================================== -->
        <div id="install-help-modal" class="hidden absolute inset-0 z-40 bg-black/65 backdrop-blur-xs flex flex-col justify-end sm:justify-center p-0 sm:p-4">
            <div class="bg-white dark:bg-[#161b26] w-full sm:rounded-2xl rounded-t-2xl p-5 shadow-2xl border border-slate-200 dark:border-slate-800 space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="p-2 rounded-xl bg-orange-500/15 text-orange-500">
                            <i data-lucide="smartphone" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-sm text-slate-900 dark:text-white">Baixar Aplicativo</h3>
                            <p class="text-[11px] text-slate-500">Para celular e tablet (Android / iOS)</p>
                        </div>
                    </div>
                    <button onclick="closeInstallHelpModal()" class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>

                <!-- Botão Direto PWA (se suportado pelo navegador) -->
                <button id="pwa-direct-install-btn" onclick="triggerPwaInstall()" class="hidden w-full py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-md transition">
                    <i data-lucide="download-cloud" class="w-4 h-4"></i>
                    Instalar Aplicativo Agora
                </button>

                <!-- Download Direto do Aplicativo -->
                <div class="bg-slate-100 dark:bg-slate-900 rounded-xl p-4 space-y-3 border border-slate-200 dark:border-slate-800">
                    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed text-center">
                        Clique abaixo para baixar o aplicativo diretamente para o seu celular ou tablet:
                    </p>
                    <button onclick="downloadHtmlAppFile()" class="w-full py-3 px-4 rounded-xl bg-orange-500 hover:bg-orange-400 text-white text-xs sm:text-sm font-bold flex items-center justify-center gap-2 shadow-md shadow-orange-500/20 transition">
                        <i data-lucide="download" class="w-4 h-4"></i>
                        <span>Baixar Aplicativo</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- MODAL: ADICIONAR / REMOVER MOEDAS          -->
        <!-- ========================================== -->
        <div id="add-currency-modal" class="hidden absolute inset-0 z-40 bg-black/60 backdrop-blur-xs flex flex-col justify-end sm:justify-center p-0 sm:p-4">
            <div class="bg-white dark:bg-[#161b26] w-full sm:rounded-2xl rounded-t-2xl max-h-[82%] flex flex-col shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden">
                <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                    <h3 class="font-bold text-sm text-slate-900 dark:text-white">Gerenciar Moedas na Tela</h3>
                    <button onclick="closeAddCurrencyModal()" class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>
                <div class="p-3 border-b border-slate-200 dark:border-slate-800">
                    <input type="text" id="currency-search-input" oninput="renderModalCurrencyList()" placeholder="Buscar moeda (ex: USD, BRL, SOL, BTC, POL...)" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 focus:outline-none focus:border-sky-500 text-slate-900 dark:text-white">
                </div>
                <div id="modal-currency-list" class="flex-1 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800/70 p-2"></div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- MODAL: GRÁFICO HISTÓRICO (CHARTS)          -->
        <!-- ========================================== -->
        <div id="chart-modal" class="hidden absolute inset-0 z-40 bg-black/60 backdrop-blur-xs flex flex-col justify-end sm:justify-center p-0 sm:p-4">
            <div class="bg-white dark:bg-[#161b26] w-full sm:rounded-2xl rounded-t-2xl p-4 shadow-2xl border border-slate-200 dark:border-slate-800 space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 id="chart-modal-title" class="font-bold text-sm text-slate-900 dark:text-white">Histórico USD → BRL</h3>
                        <p id="chart-modal-subtitle" class="text-[11px] text-slate-500">Variação recente da cotação</p>
                    </div>
                    <button onclick="closeChartModal()" class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>
                <div class="grid grid-cols-4 gap-1.5 bg-slate-100 dark:bg-slate-900 p-1 rounded-xl text-[11px] font-semibold">
                    <button onclick="updateHistoryChart(7, this)" class="chart-range-btn py-1 rounded-lg bg-white dark:bg-slate-800 text-sky-600 dark:text-sky-400 shadow-xs">7D</button>
                    <button onclick="updateHistoryChart(30, this)" class="chart-range-btn py-1 rounded-lg text-slate-500">1M</button>
                    <button onclick="updateHistoryChart(90, this)" class="chart-range-btn py-1 rounded-lg text-slate-500">3M</button>
                    <button onclick="updateHistoryChart(365, this)" class="chart-range-btn py-1 rounded-lg text-slate-500">1A</button>
                </div>
                <div class="h-48 w-full">
                    <canvas id="rate-history-canvas"></canvas>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- MODAL: MINHA TAXA PERSONALIZADA (MY RATE)  -->
        <!-- ========================================== -->
        <div id="custom-rate-modal" class="hidden absolute inset-0 z-40 bg-black/60 backdrop-blur-xs flex flex-col justify-end sm:justify-center p-0 sm:p-4">
            <div class="bg-white dark:bg-[#161b26] w-full sm:rounded-2xl rounded-t-2xl p-4 shadow-2xl border border-slate-200 dark:border-slate-800 space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="font-bold text-sm text-slate-900 dark:text-white">Minha Taxa Personalizada</h3>
                    <button onclick="closeCustomRateModal()" class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Defina uma cotação manual (ex: câmbio turismo ou taxa de corretora) para substituir a cotação automática:
                </p>
                <div class="space-y-2">
                    <label id="custom-rate-label" class="text-xs font-semibold text-slate-700 dark:text-slate-300 block">1 USD vale quanto em BRL?</label>
                    <input type="number" step="any" id="custom-rate-input" class="w-full px-3 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 font-mono text-sm font-bold text-slate-900 dark:text-white focus:outline-none focus:border-sky-500">
                </div>
                <div class="flex items-center justify-between gap-2 pt-1">
                    <button onclick="resetCustomRate()" class="px-3 py-2 rounded-xl bg-slate-200 dark:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:opacity-90">
                        Restaurar Oficial
                    </button>
                    <button onclick="saveCustomRate()" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold">
                        Aplicar Minha Taxa
                    </button>
                </div>
            </div>
        </div>

    </div>

    <script>
        // ==========================================
        // BANCO DE MOEDAS, BANDEIRAS & ÍCONES OFICIAIS
        // ==========================================
        const ALL_CURRENCIES = [
            { code: 'USD', name: 'Dólar Americano', symbol: '$', country: 'us', decimals: 2 },
            { code: 'BRL', name: 'Real Brasileiro', symbol: 'R$', country: 'br', decimals: 2 },
            { code: 'EUR', name: 'Euro', symbol: '€', country: 'eu', decimals: 2 },
            { code: 'GBP', name: 'Libra Esterlina', symbol: '£', country: 'gb', decimals: 2 },
            { code: 'CAD', name: 'Dólar Canadense', symbol: 'C$', country: 'ca', decimals: 2 },
            { code: 'AUD', name: 'Dólar Australiano', symbol: 'A$', country: 'au', decimals: 2 },
            { code: 'JPY', name: 'Iene Japonês', symbol: '¥', country: 'jp', decimals: 0 },
            { code: 'CHF', name: 'Franco Suíço', symbol: 'Fr', country: 'ch', decimals: 2 },
            { code: 'ARS', name: 'Peso Argentino', symbol: '$', country: 'ar', decimals: 2 },
            { code: 'PYG', name: 'Guarani Paraguaio', symbol: '₲', country: 'py', decimals: 0 },
            { code: 'CLP', name: 'Peso Chileno', symbol: '$', country: 'cl', decimals: 0 },
            { code: 'UYU', name: 'Peso Uruguaio', symbol: '$U', country: 'uy', decimals: 2 },
            { code: 'MXN', name: 'Peso Mexicano', symbol: '$', country: 'mx', decimals: 2 },
            { code: 'CNY', name: 'Yuan Chinês', symbol: '¥', country: 'cn', decimals: 2 },
            { code: 'BTC', name: 'Bitcoin', symbol: '₿', crypto: 'btc', decimals: 6 },
            { code: 'ETH', name: 'Ethereum', symbol: 'Ξ', crypto: 'eth', decimals: 5 },
            { code: 'SOL', name: 'Solana', symbol: '◎', crypto: 'sol', decimals: 4 },
            { code: 'POL', name: 'Polygon', symbol: '⬡', crypto: 'pol', decimals: 3 },
            { code: 'TRX', name: 'TRON', symbol: '◈', crypto: 'trx', decimals: 3 },
            { code: 'BNB', name: 'BNB Chain', symbol: '❖', crypto: 'bnb', decimals: 4 }
        ];

        // Ícones vetoriais oficiais de alta precisão para Criptomoedas + Bandeiras SVG HD para Moedas Fiduciárias
        function getCurrencyBadgeHtml(info, sizeClass = 'w-9 h-9') {
            if (info.crypto) {
                const cryptoSvgs = {
                    btc: `<div class="${sizeClass} rounded-full bg-gradient-to-br from-[#f7931a] to-[#d97706] flex items-center justify-center shadow-sm ring-1 ring-black/10 shrink-0">
                            <svg viewBox="0 0 32 32" class="w-5 h-5 fill-white"><path d="M23.189 14.02c.314-2.096-1.283-3.223-3.465-3.975l.708-2.84-1.728-.43-.69 2.765c-.454-.114-.92-.22-1.385-.326l.695-2.783L15.596 6l-.708 2.839c-.376-.086-.746-.17-1.104-.26l.002-.009-2.384-.595-.46 1.846s1.283.294 1.256.312c.7.175.826.638.805 1.006l-.806 3.235c.048.012.11.03.18.057l-.183-.045-1.13 4.532c-.086.212-.303.531-.793.41.018.025-1.256-.313-1.256-.313l-.858 1.978 2.25.561c.418.105.828.215 1.231.318l-.715 2.872 1.727.43.708-2.84c.472.127.93.245 1.378.357l-.706 2.828 1.728.43.715-2.866c2.948.558 5.164.333 6.097-2.333.752-2.146-.037-3.385-1.588-4.192 1.13-.26 1.98-1.003 2.207-2.538zm-3.95 5.538c-.533 2.147-4.148.986-5.32.695l.95-3.805c1.172.293 4.929.872 4.37 3.11zm.535-5.569c-.487 1.953-3.495.96-4.47.717l.86-3.45c.975.243 4.118.696 3.61 2.733z"/></svg>
                          </div>`,
                    eth: `<div class="${sizeClass} rounded-full bg-gradient-to-br from-[#627eea] to-[#3c54b8] flex items-center justify-center shadow-sm ring-1 ring-black/10 shrink-0">
                            <svg viewBox="0 0 32 32" class="w-5 h-5 fill-white"><path d="M16.498 4v8.87l7.497 3.35z" fill-opacity="0.75"/><path d="M16.498 4L9 16.22l7.498-3.35z"/><path d="M16.498 21.968v6.027L24 17.616z" fill-opacity="0.75"/><path d="M16.498 27.995v-6.028L9 17.616z"/><path d="M16.498 20.573l7.497-4.353-7.497-3.348z" fill-opacity="0.55"/><path d="M9 16.22l7.498 4.353v-7.701z" fill-opacity="0.85"/></svg>
                          </div>`,
                    sol: `<div class="${sizeClass} rounded-full bg-gradient-to-br from-[#141722] via-[#1c1f2e] to-[#0f111a] flex items-center justify-center shadow-sm ring-1 ring-purple-500/40 shrink-0">
                            <svg viewBox="0 0 397.7 311.7" class="w-5 h-5">
                                <defs>
                                    <linearGradient id="solGrad1" x1="0%" y1="100%" x2="100%" y2="0%">
                                        <stop offset="0%" stop-color="#9945FF"/>
                                        <stop offset="50%" stop-color="#19FB9B"/>
                                        <stop offset="100%" stop-color="#00FFA3"/>
                                    </linearGradient>
                                </defs>
                                <path fill="url(#solGrad1)" d="M64.6 237.9c2.4-2.4 5.7-3.8 9.2-3.8h317.4c5.8 0 8.7 7 4.6 11.1l-62.7 62.7c-2.4 2.4-5.7 3.8-9.2 3.8H6.5c-5.8 0-8.7-7-4.6-11.1l62.7-62.7z"/>
                                <path fill="url(#solGrad1)" d="M64.6 3.8C67.1 1.4 70.4 0 73.8 0h317.4c5.8 0 8.7 7 4.6 11.1l-62.7 62.7c-2.4 2.4-5.7 3.8-9.2 3.8H6.5c-5.8 0-8.7-7-4.6-11.1L64.6 3.8z"/>
                                <path fill="url(#solGrad1)" d="M333.1 120.1c-2.4-2.4-5.7-3.8-9.2-3.8H6.5c-5.8 0-8.7 7-4.6 11.1l62.7 62.7c2.4 2.4 5.7 3.8 9.2 3.8h317.4c5.8 0 8.7-7 4.6-11.1l-62.7-62.7z"/>
                            </svg>
                          </div>`,
                    pol: `<div class="${sizeClass} rounded-full bg-gradient-to-br from-[#8247e5] to-[#5b21b6] flex items-center justify-center shadow-sm ring-1 ring-black/10 shrink-0">
                            <svg viewBox="0 0 38.4 33.5" class="w-5 h-5 fill-white"><path d="M28.8 10.2c-.7-.4-1.6-.4-2.4 0l-5.6 3.3-3.8 2.1-5.6 3.3c-.7.4-1.6.4-2.4 0l-4.4-2.6c-.7-.4-1.2-1.2-1.2-2.1v-5.1c0-.8.4-1.6 1.2-2.1l4.4-2.5c.7-.4 1.6-.4 2.4 0l4.4 2.5c.7.4 1.2 1.2 1.2 2.1v3.3l3.8-2.2V6.9c0-.8-.4-1.6-1.2-2.1L11.4.3c-.7-.4-1.6-.4-2.4 0L1.2 4.8C.4 5.2 0 6 0 6.9v9.2c0 .8.4 1.6 1.2 2.1l7.8 4.5c.7.4 1.6.4 2.4 0l5.6-3.2 3.8-2.2 5.6-3.2c.7-.4 1.6-.4 2.4 0l4.4 2.5c.7.4 1.2 1.2 1.2 2.1v5.1c0 .8-.4 1.6-1.2 2.1l-4.4 2.6c-.7.4-1.6.4-2.4 0l-4.4-2.5c-.7-.4-1.2-1.2-1.2-2.1v-3.2l-3.8 2.2v3.3c0 .8.4 1.6 1.2 2.1l7.8 4.5c.7.4 1.6.4 2.4 0l7.8-4.5c.7-.4 1.2-1.2 1.2-2.1v-9.2c0-.8-.4-1.6-1.2-2.1l-7.8-4.6z"/></svg>
                          </div>`,
                    trx: `<div class="${sizeClass} rounded-full bg-gradient-to-br from-[#ef0027] to-[#b91c1c] flex items-center justify-center shadow-sm ring-1 ring-black/10 shrink-0">
                            <svg viewBox="0 0 32 32" class="w-5 h-5 fill-white"><path d="M25.6 10.5L6.2 6.8l9.1 19.6 11.9-14.2-1.6-1.7zm-9.4 1.7l6.9 1.3-5.2 2.3-1.7-3.6zm-1.4.6l1.7 3.7-6.7-7.1 5 3.4zm2.2 4.5l6-2.7-6.8 8.2.8-5.5z"/></svg>
                          </div>`,
                    bnb: `<div class="${sizeClass} rounded-full bg-gradient-to-br from-[#f3ba2f] to-[#d99b16] flex items-center justify-center shadow-sm ring-1 ring-black/10 shrink-0">
                            <svg viewBox="0 0 32 32" class="w-5 h-5 fill-white"><path d="M16 6.2l3.8 3.8-2.2 2.2-1.6-1.6-1.6 1.6-2.2-2.2L16 6.2zm-6 6l2.2 2.2-2.2 2.2-2.2-2.2L10 12.2zm12 0l2.2 2.2-2.2 2.2-2.2-2.2L22 12.2zM16 13.8l2.2 2.2-2.2 2.2-2.2-2.2 2.2-2.2zm0 8.4l1.6-1.6 2.2 2.2L16 26.6l-3.8-3.8 2.2-2.2 1.6 1.6z"/></svg>
                          </div>`
                };
                return cryptoSvgs[info.crypto] || '';
            }

            // Bandeira circular nítida via FlagCDN com fallback para o símbolo da moeda
            const flagUrl = `https://flagcdn.com/w80/${info.country}.png`;
            return `
                <div class="${sizeClass} rounded-full overflow-hidden shadow-sm ring-1 ring-slate-300/80 dark:ring-slate-700 bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0 relative">
                    <img src="${flagUrl}" alt="${info.code}" class="w-full h-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <span class="hidden w-full h-full items-center justify-center font-bold text-xs text-slate-700 dark:text-slate-200">${info.symbol}</span>
                </div>
            `;
        }

        const STORAGE_KEY = 'conversor_plus_state_v3';

        // Taxas base em relação a 1 USD (atualizadas em tempo real)
        const baseRatesUsd = {
            USD: 1,
            BRL: 5.75,
            EUR: 0.92,
            GBP: 0.79,
            CAD: 1.39,
            AUD: 1.53,
            JPY: 153.5,
            CHF: 0.88,
            ARS: 1015.0,
            PYG: 7850.0,
            CLP: 965.0,
            UYU: 42.3,
            MXN: 20.15,
            CNY: 7.22,
            BTC: 1 / 89500,
            ETH: 1 / 3150,
            SOL: 1 / 215,
            POL: 1 / 0.55,
            TRX: 1 / 0.24,
            BNB: 1 / 620
        };

        const appState = {
            selectedCodes: ['USD', 'BRL', 'EUR', 'BTC', 'ETH', 'SOL', 'POL', 'TRX', 'BNB'],
            activeCode: 'USD',
            inputString: '100',
            pendingOperator: null,
            previousValue: null,
            resetOnNextDigit: false,
            keypadExpanded: true,
            customRatesUsd: {},
            chartInstance: null
        };

        function safeCreateIcons() {
            if (window.lucide && typeof window.lucide.createIcons === 'function') {
                window.lucide.createIcons();
            }
        }

        // ==========================================
        // INICIALIZAÇÃO & PERSISTÊNCIA OFFLINE
        // ==========================================
        window.addEventListener('DOMContentLoaded', () => {
            loadFromStorage();
            safeCreateIcons();
            renderCurrencyRows();
            fetchLiveRates(false);
            initPhysicalKeyboard();
            setupPwaSupport();

            // Atualização automática em tempo real a cada 30 segundos
            setInterval(() => {
                fetchLiveRates(false);
            }, 30000);
        });

        // ==========================================
        // SUPORTE PWA (INSTALAÇÃO COMO APP NO CELULAR)
        // ==========================================
        let deferredInstallPrompt = null;

        function setupPwaSupport() {
            // Gera ícone SVG dinâmico e Manifesto PWA para permitir instalação como app nativo
            const svgIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><rect width="512" height="512" rx="110" fill="#2b6cb0"/><rect x="86" y="76" width="340" height="84" rx="18" fill="#38bdf8"/><text x="396" y="136" font-family="monospace" font-weight="bold" font-size="52" fill="#0f172a" text-anchor="end">100</text><rect x="86" y="186" width="102" height="102" rx="18" fill="#f1f5f9"/><text x="137" y="254" font-family="sans-serif" font-weight="bold" font-size="54" fill="#334155" text-anchor="middle">$</text><rect x="205" y="186" width="102" height="102" rx="18" fill="#f1f5f9"/><text x="256" y="254" font-family="sans-serif" font-weight="bold" font-size="54" fill="#334155" text-anchor="middle">€</text><rect x="86" y="306" width="102" height="102" rx="18" fill="#f1f5f9"/><text x="137" y="374" font-family="sans-serif" font-weight="bold" font-size="54" fill="#334155" text-anchor="middle">£</text><rect x="205" y="306" width="102" height="102" rx="18" fill="#f1f5f9"/><text x="256" y="374" font-family="sans-serif" font-weight="bold" font-size="54" fill="#334155" text-anchor="middle">¥</text><rect x="324" y="186" width="102" height="222" rx="18" fill="#f97316"/><text x="375" y="318" font-family="sans-serif" font-weight="bold" font-size="72" fill="#ffffff" text-anchor="middle">=</text></svg>`;
            const iconUrl = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgIcon);

            const manifest = {
                name: 'Conversor de Moedas Plus',
                short_name: 'Conversor Plus',
                start_url: '.',
                display: 'standalone',
                background_color: '#12161f',
                theme_color: '#2b6cb0',
                icons: [{ src: iconUrl, sizes: '512x512', type: 'image/svg+xml' }]
            };

            const manifestBlob = new Blob([JSON.stringify(manifest)], { type: 'application/manifest+json' });
            const manifestLink = document.createElement('link');
            manifestLink.rel = 'manifest';
            manifestLink.href = URL.createObjectURL(manifestBlob);
            document.head.appendChild(manifestLink);

            window.addEventListener('beforeinstallprompt', (e) => {
                e.preventDefault();
                deferredInstallPrompt = e;
                const directBtn = document.getElementById('pwa-direct-install-btn');
                if (directBtn) directBtn.classList.remove('hidden');
            });
        }

        function openInstallHelpModal() {
            document.getElementById('install-help-modal').classList.remove('hidden');
            safeCreateIcons();
        }

        function closeInstallHelpModal() {
            document.getElementById('install-help-modal').classList.add('hidden');
        }

        async function triggerPwaInstall() {
            if (!deferredInstallPrompt) {
                showToast('Use o menu (⋮) do Chrome > "Adicionar à tela inicial".');
                return;
            }
            deferredInstallPrompt.prompt();
            const { outcome } = await deferredInstallPrompt.userChoice;
            if (outcome === 'accepted') {
                showToast('Aplicativo instalado na tela inicial!');
                closeInstallHelpModal();
            }
            deferredInstallPrompt = null;
        }

        function downloadHtmlAppFile() {
            const fullHtml = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
            const blob = new Blob([fullHtml], { type: 'text/html;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'index.html';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast('Arquivo index.html baixado!');
        }

        async function downloadZipPackage() {
            try {
                if (typeof JSZip === 'undefined') {
                    downloadHtmlAppFile();
                    return;
                }
                const fullHtml = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
                const zip = new JSZip();
                zip.file('index.html', fullHtml);
                const zipBlob = await zip.generateAsync({ type: 'blob' });
                const url = URL.createObjectURL(zipBlob);
                const a = document.createElement('a');
                a.href = url;
                a.download = 'conversor-plus.zip';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                showToast('Pacote conversor-plus.zip baixado!');
            } catch (e) {
                downloadHtmlAppFile();
            }
        }

        function saveToStorage() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify({
                    selectedCodes: appState.selectedCodes,
                    activeCode: appState.activeCode,
                    baseRatesUsd,
                    customRatesUsd: appState.customRatesUsd
                }));
            } catch (e) {}
        }

        function loadFromStorage() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (!raw) return;
                const saved = JSON.parse(raw);
                if (Array.isArray(saved.selectedCodes) && saved.selectedCodes.length >= 2) {
                    appState.selectedCodes = saved.selectedCodes;
                }
                if (saved.activeCode && appState.selectedCodes.includes(saved.activeCode)) {
                    appState.activeCode = saved.activeCode;
                }
                if (saved.baseRatesUsd) {
                    Object.assign(baseRatesUsd, saved.baseRatesUsd);
                }
                if (saved.customRatesUsd) {
                    appState.customRatesUsd = saved.customRatesUsd;
                }
            } catch (e) {}
        }

        async function fetchLiveRates(manual = false) {
            const icon = document.getElementById('header-refresh-icon');
            const statusText = document.getElementById('sync-status-text');
            if (manual && icon) icon.classList.add('animate-spin');

            try {
                const [fiatRes, cryptoRes] = await Promise.all([
                    fetch('https://open.er-api.com/v6/latest/USD'),
                    fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,polygon-ecosystem-token,matic-network,tron,binancecoin&vs_currencies=usd')
                ]);

                if (fiatRes.ok) {
                    const fiatData = await fiatRes.json();
                    if (fiatData?.rates) {
                        Object.keys(baseRatesUsd).forEach(code => {
                            if (fiatData.rates[code]) baseRatesUsd[code] = fiatData.rates[code];
                        });
                    }
                }

                if (cryptoRes.ok) {
                    const cryptoData = await cryptoRes.json();
                    if (cryptoData.bitcoin?.usd) baseRatesUsd.BTC = 1 / cryptoData.bitcoin.usd;
                    if (cryptoData.ethereum?.usd) baseRatesUsd.ETH = 1 / cryptoData.ethereum.usd;
                    if (cryptoData.solana?.usd) baseRatesUsd.SOL = 1 / cryptoData.solana.usd;
                    const polPrice = cryptoData['polygon-ecosystem-token']?.usd || cryptoData['matic-network']?.usd;
                    if (polPrice) baseRatesUsd.POL = 1 / polPrice;
                    if (cryptoData.tron?.usd) baseRatesUsd.TRX = 1 / cryptoData.tron.usd;
                    if (cryptoData.binancecoin?.usd) baseRatesUsd.BNB = 1 / cryptoData.binancecoin.usd;
                }

                const nowStr = new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                statusText.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-pulse"></span> Ao vivo (${nowStr})`;
                saveToStorage();
                renderCurrencyRows();
                if (manual) showToast('Cotações atualizadas em tempo real!');
            } catch (err) {
                statusText.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-300"></span> Modo Offline (taxas salvas)`;
                if (manual) showToast('Sem conexão. Usando últimas taxas salvas.');
            } finally {
                if (icon) setTimeout(() => icon.classList.remove('animate-spin'), 450);
            }
        }

        function getEffectiveUsdRate(code) {
            if (appState.customRatesUsd[code]) {
                return appState.customRatesUsd[code];
            }
            return baseRatesUsd[code] || 1;
        }

        function getActiveNumericValue() {
            const cleaned = appState.inputString.replace(',', '.');
            const num = parseFloat(cleaned);
            return isNaN(num) ? 0 : num;
        }

        // ==========================================
        // RENDERIZAÇÃO DA LISTA SIMULTÂNEA DE MOEDAS
        // ==========================================
        function renderCurrencyRows() {
            const container = document.getElementById('currency-list-container');
            const activeValue = getActiveNumericValue();
            const activeUsdRate = getEffectiveUsdRate(appState.activeCode);
            const valueInUsd = activeUsdRate > 0 ? (activeValue / activeUsdRate) : 0;

            // Atualiza banner de expressão matemática se houver operador pendente
            const exprBanner = document.getElementById('expression-banner');
            if (appState.pendingOperator && appState.previousValue !== null) {
                const opMap = { '+': '+', '-': '−', '*': '×', '/': '÷' };
                document.getElementById('expr-currency-code').textContent = appState.activeCode;
                document.getElementById('expression-text').textContent = `${formatDisplayNumber(appState.previousValue, 4)} ${opMap[appState.pendingOperator]} ${appState.inputString}`;
                exprBanner.classList.remove('hidden');
            } else {
                exprBanner.classList.add('hidden');
            }

            container.innerHTML = appState.selectedCodes.map(code => {
                const info = ALL_CURRENCIES.find(c => c.code === code) || { code, name: code, symbol: '$', country: 'un', decimals: 2 };
                const isActive = code === appState.activeCode;
                const targetUsdRate = getEffectiveUsdRate(code);
                const unitRate = activeUsdRate > 0 ? (targetUsdRate / activeUsdRate) : 1;
                const isCustom = Boolean(appState.customRatesUsd[code]);
                const iconBadgeHtml = getCurrencyBadgeHtml(info, 'w-9 h-9');

                let displayValueStr = '';
                if (isActive) {
                    // Mostra exatamente o que o usuário está digitando (com vírgula decimal estilo Brasil)
                    displayValueStr = formatRawInputString(appState.inputString);
                } else {
                    const convertedVal = valueInUsd * targetUsdRate;
                    displayValueStr = formatDisplayNumber(convertedVal, info.decimals);
                }

                const unitRateFormatted = unitRate < 0.01 && unitRate > 0
                    ? unitRate.toFixed(6).replace('.', ',')
                    : unitRate.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 4 });

                return `
                    <div data-code="${code}" onclick="selectActiveCurrency('${code}')" class="currency-row-item px-3 sm:px-4 py-3 flex items-center justify-between gap-2.5 cursor-pointer select-none ${isActive ? 'bg-sky-50/90 dark:bg-sky-950/35 border-l-4 border-l-sky-600 dark:border-l-sky-400' : 'hover:bg-slate-50 dark:hover:bg-slate-900/50 border-l-4 border-l-transparent'}">
                        <!-- Esquerda: Alça de Arrastar + Ícone Oficial / Bandeira + Código + Nome -->
                        <div class="flex items-center gap-2.5 min-w-0">
                            <div class="drag-handle touch-none p-1 -ml-1 text-slate-300 dark:text-slate-600 hover:text-sky-500 cursor-grab active:cursor-grabbing shrink-0" title="Segure e arraste para reordenar">
                                <i data-lucide="grip-vertical" class="w-4 h-4"></i>
                            </div>
                            ${iconBadgeHtml}
                            <div class="min-w-0">
                                <div class="flex items-center gap-1.5">
                                    <span class="font-bold text-sm sm:text-[15px] ${isActive ? 'text-sky-700 dark:text-sky-300' : 'text-slate-800 dark:text-slate-100'}">${info.code}</span>
                                    <span class="text-[10px] font-mono font-bold px-1.5 py-0.2 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200/80 dark:border-slate-700/80">${info.symbol}</span>
                                    ${isCustom ? '<span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-600 dark:text-amber-400">Manual</span>' : ''}
                                </div>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate">${info.name}</p>
                            </div>
                        </div>

                        <!-- Direita: Valor Grande com Símbolo Monetário + Taxa Unitária + Mini Gráfico -->
                        <div class="flex items-center gap-2 shrink-0">
                            <div class="text-right">
                                <div class="font-mono text-lg sm:text-xl font-bold tracking-tight flex items-baseline justify-end gap-1 ${isActive ? 'text-sky-700 dark:text-sky-300' : 'text-slate-900 dark:text-white'}">
                                    <span class="text-xs sm:text-sm font-semibold opacity-65">${info.symbol}</span>
                                    <span>${displayValueStr}</span>
                                </div>
                                <div class="text-[10px] font-mono text-slate-400">
                                    ${isActive ? 'Moeda base ativa' : `1 ${appState.activeCode} = ${unitRateFormatted} ${code}`}
                                </div>
                            </div>

                            <!-- Ícone de gráfico lateral igual ao print da Play Store -->
                            <button onclick="event.stopPropagation(); openChartForPair('${appState.activeCode}', '${code}')" class="p-1.5 rounded-lg text-slate-400 hover:text-sky-600 dark:hover:text-sky-400 hover:bg-slate-200/60 dark:hover:bg-slate-800 transition" title="Ver gráfico ${appState.activeCode}/${code}">
                                <i data-lucide="line-chart" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            attachDragReorderHandlers();
            safeCreateIcons();
        }

        // ==========================================
        // ARRASTAR E SOLTAR MOEDAS (TOQUE & MOUSE)
        // ==========================================
        let isDraggingRow = false;
        let suppressNextRowClick = false;

        function attachDragReorderHandlers() {
            const container = document.getElementById('currency-list-container');
            const rows = Array.from(container.querySelectorAll('.currency-row-item'));

            rows.forEach(row => {
                let pressTimer = null;
                let startY = 0;
                let activeDrag = false;
                let currentHoverRow = null;

                const startDrag = () => {
                    activeDrag = true;
                    isDraggingRow = true;
                    suppressNextRowClick = true;
                    row.classList.add('currency-row-dragging', 'bg-sky-100/90', 'dark:bg-sky-900/60');
                    if (navigator.vibrate) navigator.vibrate(25);
                };

                const onPointerDown = (e) => {
                    if (e.target.closest('button')) return;
                    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                    startY = clientY;
                    const isHandle = Boolean(e.target.closest('.drag-handle'));

                    if (isHandle) {
                        e.preventDefault();
                        startDrag();
                    } else {
                        // Segurar 240ms em qualquer lugar da linha ativa o modo arrastar
                        pressTimer = setTimeout(startDrag, 240);
                    }
                };

                const onPointerMove = (e) => {
                    const clientY = e.touches ? e.touches[0].clientY : e.clientY;

                    if (!activeDrag) {
                        if (Math.abs(clientY - startY) > 8 && pressTimer) {
                            clearTimeout(pressTimer);
                            pressTimer = null;
                        }
                        return;
                    }

                    if (e.cancelable) e.preventDefault();

                    rows.forEach(r => r.classList.remove('currency-row-over'));
                    const targetRow = rows.find(r => {
                        if (r === row) return false;
                        const rect = r.getBoundingClientRect();
                        return clientY >= rect.top && clientY <= rect.bottom;
                    });

                    currentHoverRow = targetRow || null;
                    if (currentHoverRow) {
                        currentHoverRow.classList.add('currency-row-over');
                    }
                };

                const onPointerEnd = () => {
                    if (pressTimer) {
                        clearTimeout(pressTimer);
                        pressTimer = null;
                    }

                    if (activeDrag) {
                        row.classList.remove('currency-row-dragging', 'bg-sky-100/90', 'dark:bg-sky-900/60');
                        rows.forEach(r => r.classList.remove('currency-row-over'));

                        if (currentHoverRow) {
                            const fromCode = row.dataset.code;
                            const toCode = currentHoverRow.dataset.code;
                            const fromIdx = appState.selectedCodes.indexOf(fromCode);
                            const toIdx = appState.selectedCodes.indexOf(toCode);

                            if (fromIdx !== -1 && toIdx !== -1 && fromIdx !== toIdx) {
                                appState.selectedCodes.splice(fromIdx, 1);
                                appState.selectedCodes.splice(toIdx, 0, fromCode);
                                saveToStorage();
                                renderCurrencyRows();
                                showToast(`${fromCode} movido na lista!`);
                            }
                        }

                        activeDrag = false;
                        isDraggingRow = false;
                        setTimeout(() => { suppressNextRowClick = false; }, 120);
                    }
                };

                row.addEventListener('mousedown', onPointerDown);
                window.addEventListener('mousemove', onPointerMove);
                window.addEventListener('mouseup', onPointerEnd);

                row.addEventListener('touchstart', onPointerDown, { passive: false });
                row.addEventListener('touchmove', onPointerMove, { passive: false });
                row.addEventListener('touchend', onPointerEnd);
                row.addEventListener('touchcancel', onPointerEnd);
            });
        }
// ... existing code ... -->
        function selectActiveCurrency(code) {
            if (suppressNextRowClick || isDraggingRow) return;
            if (code === appState.activeCode) {
                if (!appState.keypadExpanded) toggleKeypad();
                return;
            }

            const currentVal = getActiveNumericValue();
            const fromUsdRate = getEffectiveUsdRate(appState.activeCode);
            const toUsdRate = getEffectiveUsdRate(code);
            const converted = fromUsdRate > 0 ? (currentVal / fromUsdRate) * toUsdRate : currentVal;

            const info = ALL_CURRENCIES.find(c => c.code === code) || { decimals: 2 };
            appState.activeCode = code;
            appState.inputString = converted === 0 ? '0' : Number(converted.toFixed(info.decimals)).toString().replace('.', ',');
            appState.pendingOperator = null;
            appState.previousValue = null;
            appState.resetOnNextDigit = true;

            saveToStorage();
            renderCurrencyRows();
        }

        function swapTopTwoCurrencies() {
            if (appState.selectedCodes.length < 2) return;
            const [first, second] = appState.selectedCodes;
            appState.selectedCodes[0] = second;
            appState.selectedCodes[1] = first;
            const nextActive = appState.activeCode === first ? second : first;
            saveToStorage();
            selectActiveCurrency(nextActive);
        }

        // ==========================================
        // TECLADO & CALCULADORA EMBUTIDA
        // ==========================================
        function pressDigit(digit) {
            if (appState.resetOnNextDigit) {
                appState.inputString = digit;
                appState.resetOnNextDigit = false;
            } else if (appState.inputString === '0') {
                appState.inputString = digit;
            } else if (appState.inputString.replace(',', '').length < 14) {
                appState.inputString += digit;
            }
            renderCurrencyRows();
        }

        function pressDecimal() {
            if (appState.resetOnNextDigit) {
                appState.inputString = '0,';
                appState.resetOnNextDigit = false;
            } else if (!appState.inputString.includes(',')) {
                appState.inputString += ',';
            }
            renderCurrencyRows();
        }

        function pressBackspace() {
            if (appState.resetOnNextDigit) {
                appState.inputString = '0';
                appState.resetOnNextDigit = false;
            } else if (appState.inputString.length <= 1) {
                appState.inputString = '0';
            } else {
                appState.inputString = appState.inputString.slice(0, -1);
            }
            renderCurrencyRows();
        }

        function pressClear() {
            appState.inputString = '0';
            appState.pendingOperator = null;
            appState.previousValue = null;
            appState.resetOnNextDigit = false;
            renderCurrencyRows();
        }

        function pressOperator(op) {
            const currentVal = getActiveNumericValue();
            if (appState.pendingOperator && appState.previousValue !== null && !appState.resetOnNextDigit) {
                const evaluated = computeOperation(appState.previousValue, currentVal, appState.pendingOperator);
                appState.previousValue = evaluated;
                appState.inputString = formatNumberToInput(evaluated);
            } else {
                appState.previousValue = currentVal;
            }
            appState.pendingOperator = op;
            appState.resetOnNextDigit = true;
            renderCurrencyRows();
        }

        function pressEquals() {
            if (!appState.pendingOperator || appState.previousValue === null) {
                appState.resetOnNextDigit = true;
                renderCurrencyRows();
                return;
            }
            const currentVal = getActiveNumericValue();
            const result = computeOperation(appState.previousValue, currentVal, appState.pendingOperator);
            appState.inputString = formatNumberToInput(result);
            appState.pendingOperator = null;
            appState.previousValue = null;
            appState.resetOnNextDigit = true;
            renderCurrencyRows();
        }

        function pressPercent() {
            const currentVal = getActiveNumericValue();
            let result = currentVal / 100;
            if (appState.pendingOperator && appState.previousValue !== null) {
                result = (appState.previousValue * currentVal) / 100;
            }
            appState.inputString = formatNumberToInput(result);
            appState.resetOnNextDigit = false;
            renderCurrencyRows();
            showToast('Porcentagem aplicada');
        }

        function computeOperation(a, b, op) {
            switch (op) {
                case '+': return a + b;
                case '-': return a - b;
                case '*': return a * b;
                case '/': return b !== 0 ? a / b : 0;
                default: return b;
            }
        }

        function formatNumberToInput(num) {
            if (!isFinite(num)) return '0';
            const rounded = Math.round(num * 1000000) / 1000000;
            return rounded.toString().replace('.', ',');
        }

        function formatRawInputString(raw) {
            const parts = raw.split(',');
            const intPart = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
            return parts.length > 1 ? `${intPart},${parts[1]}` : intPart;
        }

        function formatDisplayNumber(num, maxDecimals = 2) {
            if (!isFinite(num) || num === 0) return '0,00';
            const decimals = Math.abs(num) < 0.01 ? Math.max(maxDecimals, 6) : maxDecimals;
            return num.toLocaleString('pt-BR', {
                minimumFractionDigits: Math.min(2, decimals),
                maximumFractionDigits: decimals
            });
        }

        function initPhysicalKeyboard() {
            window.addEventListener('keydown', (e) => {
                if (e.target.tagName === 'INPUT') return;
                if (e.key >= '0' && e.key <= '9') pressDigit(e.key);
                else if (e.key === ',' || e.key === '.') pressDecimal();
                else if (e.key === 'Backspace') pressBackspace();
                else if (e.key === 'Escape' || e.key.toLowerCase() === 'c') pressClear();
                else if (e.key === '+' || e.key === '-' || e.key === '*' || e.key === '/') pressOperator(e.key);
                else if (e.key === 'Enter' || e.key === '=') {
                    e.preventDefault();
                    pressEquals();
                }
            });
        }

        // ==========================================
        // CONTROLE DE TECLADO RETRÁTIL & TEMA
        // ==========================================
        function toggleKeypad() {
            appState.keypadExpanded = !appState.keypadExpanded;
            const drawer = document.getElementById('keypad-drawer');
            const chevron = document.getElementById('keypad-chevron');
            const label = document.getElementById('keypad-toggle-label');

            if (appState.keypadExpanded) {
                drawer.style.maxHeight = '340px';
                drawer.style.opacity = '1';
                chevron.style.transform = 'rotate(0deg)';
                label.textContent = 'Recolher teclado (ver mais moedas)';
            } else {
                drawer.style.maxHeight = '0px';
                drawer.style.opacity = '0';
                chevron.style.transform = 'rotate(180deg)';
                label.textContent = 'Abrir teclado numérico';
            }
        }

        function toggleTheme() {
            const html = document.documentElement;
            const isDark = html.classList.toggle('dark');
            const icon = document.getElementById('theme-icon');
            if (icon) {
                icon.setAttribute('data-lucide', isDark ? 'sun' : 'moon');
                safeCreateIcons();
            }
        }

        function focusConverterTab() {
            closeAddCurrencyModal();
            closeChartModal();
            closeCustomRateModal();
            closeInstallHelpModal();
        }

        // ==========================================
        // MODAIS: ADICIONAR MOEDA, GRÁFICO & MINHA TAXA
        // ==========================================
        function openAddCurrencyModal() {
            document.getElementById('add-currency-modal').classList.remove('hidden');
            renderModalCurrencyList();
            safeCreateIcons();
        }

        function closeAddCurrencyModal() {
            document.getElementById('add-currency-modal').classList.add('hidden');
        }

        function renderModalCurrencyList() {
            const query = (document.getElementById('currency-search-input')?.value || '').trim().toLowerCase();
            const listEl = document.getElementById('modal-currency-list');
            const filtered = ALL_CURRENCIES.filter(c =>
                c.code.toLowerCase().includes(query) || c.name.toLowerCase().includes(query)
            );

            listEl.innerHTML = filtered.map(c => {
                const isSelected = appState.selectedCodes.includes(c.code);
                return `
                    <button onclick="toggleCurrencyInList('${c.code}')" class="w-full px-3 py-2.5 flex items-center justify-between hover:bg-slate-100 dark:hover:bg-slate-800/70 rounded-xl transition text-left">
                        <div class="flex items-center gap-2.5">
                            ${getCurrencyBadgeHtml(c, 'w-8 h-8')}
                            <div>
                                <div class="font-bold text-xs text-slate-900 dark:text-white">${c.code} <span class="text-slate-400 font-normal">(${c.symbol})</span></div>
                                <div class="text-[11px] text-slate-500">${c.name}</div>
                            </div>
                        </div>
                        <span class="text-xs font-bold px-2.5 py-1 rounded-lg ${isSelected ? 'bg-sky-500/15 text-sky-600 dark:text-sky-400' : 'bg-slate-200 dark:bg-slate-800 text-slate-500'}">
                            ${isSelected ? 'Na lista ✓' : '+ Adicionar'}
                        </span>
                    </button>
                `;
            }).join('');
        }

        function toggleCurrencyInList(code) {
            const idx = appState.selectedCodes.indexOf(code);
            if (idx !== -1) {
                if (appState.selectedCodes.length <= 2) {
                    showToast('Mantenha pelo menos 2 moedas na lista.');
                    return;
                }
                appState.selectedCodes.splice(idx, 1);
                if (appState.activeCode === code) {
                    appState.activeCode = appState.selectedCodes[0];
                }
            } else {
                appState.selectedCodes.push(code);
            }
            saveToStorage();
            renderModalCurrencyList();
            renderCurrencyRows();
        }

        let chartPairFrom = 'USD';
        let chartPairTo = 'BRL';

        function openChartModal() {
            const secondCode = appState.selectedCodes.find(c => c !== appState.activeCode) || 'BRL';
            openChartForPair(appState.activeCode, secondCode);
        }

        function openChartForPair(fromCode, toCode) {
            chartPairFrom = fromCode;
            chartPairTo = toCode === fromCode ? (appState.selectedCodes.find(c => c !== fromCode) || 'BRL') : toCode;
            document.getElementById('chart-modal-title').textContent = `Histórico ${chartPairFrom} → ${chartPairTo}`;
            document.getElementById('chart-modal').classList.remove('hidden');
            const firstBtn = document.querySelector('.chart-range-btn');
            updateHistoryChart(7, firstBtn);
            safeCreateIcons();
        }

        function closeChartModal() {
            document.getElementById('chart-modal').classList.add('hidden');
        }

        function updateHistoryChart(days, btnEl) {
            document.querySelectorAll('.chart-range-btn').forEach(b => {
                b.className = 'chart-range-btn py-1 rounded-lg text-slate-500';
            });
            if (btnEl) {
                btnEl.className = 'chart-range-btn py-1 rounded-lg bg-white dark:bg-slate-800 text-sky-600 dark:text-sky-400 shadow-xs';
            }

            const fromRate = getEffectiveUsdRate(chartPairFrom);
            const toRate = getEffectiveUsdRate(chartPairTo);
            const currentRate = fromRate > 0 ? (toRate / fromRate) : 1;

            const labels = [];
            const dataPoints = [];
            const pointsCount = Math.min(days, 24);
            let simulated = currentRate * 0.97;

            for (let i = pointsCount; i >= 0; i--) {
                const d = new Date();
                d.setDate(d.getDate() - Math.round((i * days) / pointsCount));
                labels.push(d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' }));
                if (i === 0) {
                    dataPoints.push(currentRate);
                } else {
                    const drift = (currentRate - simulated) * 0.18;
                    const wave = Math.sin(i * 1.3) * (currentRate * 0.012);
                    simulated = simulated + drift + wave;
                    dataPoints.push(Number(simulated.toFixed(6)));
                }
            }

            const canvas = document.getElementById('rate-history-canvas');
            if (!canvas || typeof Chart === 'undefined') return;
            if (appState.chartInstance) {
                appState.chartInstance.destroy();
            }

            appState.chartInstance = new Chart(canvas.getContext('2d'), {
                type: 'line',
                data: {
                    labels,
                    datasets: [{
                        label: `${chartPairFrom}/${chartPairTo}`,
                        data: dataPoints,
                        borderColor: '#0284c7',
                        backgroundColor: 'rgba(2, 132, 199, 0.12)',
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.35,
                        pointRadius: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false }, ticks: { maxTicksLimit: 6, font: { size: 10 } } },
                        y: { ticks: { font: { size: 10 } } }
                    }
                }
            });
        }

        function openCustomRateModal() {
            const targetCode = appState.selectedCodes.find(c => c !== appState.activeCode) || 'BRL';
            const currentUnitRate = getEffectiveUsdRate(targetCode) / getEffectiveUsdRate(appState.activeCode);
            document.getElementById('custom-rate-label').textContent = `1 ${appState.activeCode} vale quanto em ${targetCode}?`;
            document.getElementById('custom-rate-input').value = Number(currentUnitRate.toFixed(6));
            document.getElementById('custom-rate-modal').dataset.targetCode = targetCode;
            document.getElementById('custom-rate-modal').classList.remove('hidden');
            safeCreateIcons();
        }

        function closeCustomRateModal() {
            document.getElementById('custom-rate-modal').classList.add('hidden');
        }

        function saveCustomRate() {
            const modal = document.getElementById('custom-rate-modal');
            const targetCode = modal.dataset.targetCode || 'BRL';
            const val = parseFloat(document.getElementById('custom-rate-input').value);
            if (!val || val <= 0) {
                showToast('Informe um valor válido maior que zero.');
                return;
            }
            const activeUsd = getEffectiveUsdRate(appState.activeCode);
            appState.customRatesUsd[targetCode] = activeUsd * val;
            saveToStorage();
            renderCurrencyRows();
            closeCustomRateModal();
            showToast(`Taxa manual aplicada para ${targetCode}!`);
        }

        function resetCustomRate() {
            appState.customRatesUsd = {};
            saveToStorage();
            renderCurrencyRows();
            closeCustomRateModal();
            showToast('Taxas oficiais restauradas!');
        }

        function showToast(msg) {
            const container = document.getElementById('toast-container');
            if (!container) return;
            const el = document.createElement('div');
            el.className = 'bg-slate-900/95 text-white text-xs font-medium px-3.5 py-2.5 rounded-xl shadow-lg border border-slate-700 text-center transition-opacity duration-300';
            el.textContent = msg;
            container.appendChild(el);
            setTimeout(() => {
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 300);
            }, 2600);
        }
    </script>
</body>
</html>